<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The "My Father's Work" flavor's theme: static assets (wwwroot), the .razor components whose
       whole structure varies per theme (MainMenuScene), and the IThemeModule that registers them
       along with this flavor's WhiteLabelConfig. Selected by WhiteLabel/MyFathersWork.props; no host
       references it directly. See NOTICE.md for asset provenance. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Every flavor serves its theme from the same path (ThemeModules.AssetBasePath), so host
         markup and asset URLs never name a flavor. -->
    <StaticWebAssetBasePath>_content/theme</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterwork.App.Shared\Masterwork.App.Shared.csproj" />
  </ItemGroup>

</Project>

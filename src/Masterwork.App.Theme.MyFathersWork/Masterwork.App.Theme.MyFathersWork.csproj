<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- No .razor components — this project exists purely to package the "My Father's Work" theme's
       static assets (wwwroot) as a Razor Class Library, so they're published under
       _content/Masterwork.App.Theme.MyFathersWork/... via the same static-web-asset mechanism
       Masterwork.App.Shared already uses, transitively reaching both host apps through the ordinary
       ProjectReference graph — no custom build step needed. See NOTICE.md for asset provenance. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

</Project>

@namespace Masterwork.App.Shared.Chrome
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services
@using Masterwork.Engine
@using Masterwork.Engine.Session
@inject IJSRuntime JS

@{ AppSettingsApplier.ReassertCulture(); }
<div class="mws-pause-bar @(IsOpen ? "mws-pause-bar--open" : "")" inert="@(!IsOpen)">
    <div class="mws-pause-scrubber-row">
        <button type="button" class="mws-pause-nav-button mws-pause-back" disabled="@(_busy || !Session.CanStepBack)"
                @onclick="StepBack" aria-label="@AppStrings.TimelineScrubber_Back" title="@AppStrings.TimelineScrubber_Back"></button>
        <ol class="mws-timeline-list">
            @for (var i = 0; i < Session.Timeline.Count; i++)
            {
                var index = i;
                var snapshot = Session.Timeline[index];
                var label = snapshot.DisplayLabel ?? snapshot.PassageId;
                var isCurrent = index == Session.HistoryIndex && !Session.IsAtActiveState;
                <li @key="index" id="@EntryElementId(index)" class="mws-timeline-entry @(isCurrent ? "current" : "") @(snapshot.Kind == SnapshotKind.Checkpoint ? "checkpoint" : "")" title="@label">
                    <span class="mws-timeline-label">@label</span>
                </li>
            }
            @if (Session.HasActiveState)
            {
                <li @key="Session.Timeline.Count" id="@EntryElementId(Session.Timeline.Count)" class="mws-timeline-entry mws-timeline-current-marker @(Session.IsAtActiveState ? "current" : "")" title="@AppStrings.TimelineScrubber_CurrentLabel">
                    <span class="mws-timeline-label">@AppStrings.TimelineScrubber_CurrentLabel</span>
                </li>
            }
        </ol>
        <div class="mws-pause-forward-group">
            <button type="button" class="mws-pause-nav-button mws-pause-forward" disabled="@(_busy || !Session.CanStepForward)"
                    @onclick="StepForward" aria-label="@AppStrings.TimelineScrubber_Forward" title="@AppStrings.TimelineScrubber_Forward"></button>
            <button type="button" class="mws-pause-nav-button mws-pause-jump-to-present" disabled="@(_busy || !Session.IsRewound)"
                    @onclick="JumpToPresent" aria-label="@AppStrings.TimelineScrubber_ReturnToPresent" title="@AppStrings.TimelineScrubber_ReturnToPresent"></button>
        </div>
    </div>
    <div class="mws-pause-actions-row">
        <button type="button" class="mws-quit-button mws-btn-sm style-btn-red" disabled="@_busy" @onclick="() => _showQuitDialog = true">@AppStrings.OptionsDialog_Quit</button>
        <button type="button" class="mws-resume-button mws-btn-sm style-btn-green @(Session.IsRewound ? "mws-resume-button--long" : "")" disabled="@_busy" @onclick="OnResumeClicked">
            <span class="mws-resume-button-text">@(Session.IsRewound ? AppStrings.TimelineScrubber_ResumeFromHere : AppStrings.Common_Resume)</span>
        </button>
    </div>
</div>

@if (_showResumeConfirm)
{
    <div class="mws-dialog-overlay">
        <div class="mws-dialog mws-dialog--sm">
            <h3>@string.Format(AppStrings.EffectiveCulture, AppStrings.TimelineScrubber_ResumeConfirmTitle, Session.Current.DisplayLabel ?? Session.Current.PassageId)</h3>
            <p>@AppStrings.TimelineScrubber_ResumeConfirmBody</p>
            <p>@AppStrings.TimelineScrubber_ResumeConfirmQuestion</p>
            <div class="mws-dialog-actions">
                <button type="button" class="style-btn-red mws-btn-sm" disabled="@_busy" @onclick="ConfirmResumeFromHere">@AppStrings.Common_Yes</button>
                <button type="button" class="style-btn-brown mws-btn-sm" @onclick="() => _showResumeConfirm = false">@AppStrings.Common_No</button>
            </div>
        </div>
    </div>
}

@if (_showQuitDialog)
{
    <OptionsDialog DialogContext="OptionsDialogContext.InGame" StartAtQuit="true"
                   OnClose="() => _showQuitDialog = false"
                   OnSaveAndQuit="OnSaveAndQuit" OnAbandonGame="OnAbandonGame" DefaultSaveName="@DefaultSaveName" />
}

@code {
    /// <summary>The active session to display and navigate.</summary>
    [Parameter, EditorRequired]
    public GameSession Session { get; set; } = null!;

    /// <summary>
    /// Whether the bar is slid into view. This component is always mounted once a session exists
    /// (see Play.razor) rather than being added/removed via <c>@if</c>, specifically so the
    /// open/closed CSS transform below can animate — an unmounted component has no element to
    /// transition. <c>inert</c> follows this so the bar's buttons/scrubber aren't reachable by
    /// keyboard or click while slid off-screen.
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>Invoked after stepping back/forward, jumping to present, or resuming from history.</summary>
    [Parameter]
    public EventCallback OnStateChanged { get; set; }

    /// <summary>Invoked once the player has chosen to leave pause mode (closes this bar).</summary>
    [Parameter, EditorRequired]
    public EventCallback OnResumed { get; set; }

    /// <summary>Forwarded to the Quit flow's <see cref="OptionsDialog"/> — see its own remarks.</summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnSaveAndQuit { get; set; }

    /// <summary>Forwarded to the Quit flow's <see cref="OptionsDialog"/> — see its own remarks.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnAbandonGame { get; set; }

    /// <summary>Forwarded to the Quit flow's <see cref="OptionsDialog"/> — see its own remarks.</summary>
    [Parameter]
    public string DefaultSaveName { get; set; } = "";

    private bool _showResumeConfirm;
    private bool _showQuitDialog;
    private int _lastCenteredIndex = -1;
    private IJSObjectReference? _jsModule;
    private bool _wasOpen;

    // Guards every scrubber/resume action below against a double-click re-invoking it before the
    // first invocation's re-render disables the button — see RenderedLinkView's HandleClick for why
    // a plain bool set before the first await is sufficient under Blazor's cooperative event
    // dispatch. Shared across all of them (not one flag per method) since they're all mutually
    // exclusive actions on the same Session.
    private bool _busy;

    // A stable per-index DOM id, not an ElementReference captured via @ref — the timeline <li>s are
    // rendered in a @for whose item count changes every time the player advances or steps back, and
    // @ref on a conditionally-present list item hit a genuine Blazor diffing bug in that situation
    // (RenderTreeDiffBuilder.RemoveOldFrame throwing "Unexpected frame type... ElementReferenceCapture")
    // that persisted even with a @key on the element. timelineScrubber.js looks the element up by id
    // instead. See RenderedInputView.razor's inputFocus.js for the first place this same fix landed.
    private string EntryElementId(int index) => $"mws-timeline-entry-{index}";

    protected override void OnParametersSet()
    {
        // Defensive only (not reachable via the normal Resume/Quit flows, which already clear these
        // before IsOpen flips) — cheap insurance now that the bar stays mounted across pause/resume
        // instead of being torn down, so nothing carries over stale into the next time it opens.
        if (_wasOpen && !IsOpen)
        {
            _showResumeConfirm = false;
            _showQuitDialog = false;
        }

        _wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Masterwork.App.Shared/timelineScrubber.js");
        }

        // Skipped entirely while closed — the panel is inert/slid off-screen, so there's nothing
        // meaningful to scroll into view yet. Now that this component stays mounted across
        // pause/resume instead of unmounting (see IsOpen's own remarks), skipping here matters: this
        // would otherwise fire on the very first page load, before the player has ever opened the
        // bar, against elements the interactive runtime may not have fully attached to yet.
        // _lastCenteredIndex is deliberately left untouched so the next time it opens is still
        // treated as "changed" and centers correctly.
        if (!IsOpen)
        {
            return;
        }

        // Only re-centers when the selected entry actually changes — every unrelated re-render
        // (e.g. an input keystroke elsewhere) would otherwise re-trigger the scroll animation.
        var currentIndex = Session.IsAtActiveState ? Session.Timeline.Count : Session.HistoryIndex;
        if (currentIndex == _lastCenteredIndex)
        {
            return;
        }

        _lastCenteredIndex = currentIndex;
        if (_jsModule is not null && currentIndex >= 0)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("centerElement", EntryElementId(currentIndex));
            }
            catch (JSException)
            {
                // Best-effort UX polish only (keeps the highlighted entry scrolled into view) —
                // rapid clicking can race a re-render that swaps the referenced <li> out from under
                // this call before it resolves. Not worth surfacing an error over; the entry is
                // still correctly highlighted either way, just not necessarily re-centered this time.
            }
        }
    }

    private async Task StepBack()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            Session.StepBack();
            await OnStateChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StepForward()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            Session.StepForward();
            await OnStateChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task JumpToPresent()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            Session.JumpToPresent();
            await OnStateChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // At current, Resume is non-destructive — there's nothing rewound to discard, so it just closes
    // the bar. Anywhere else, it needs the player to explicitly confirm discarding the rewound future
    // (and any pending active state) before actually resuming from that point.
    private async Task OnResumeClicked()
    {
        if (_busy)
        {
            return;
        }

        if (!Session.IsRewound)
        {
            _busy = true;
            try
            {
                await OnResumed.InvokeAsync();
            }
            finally
            {
                _busy = false;
            }
            return;
        }

        _showResumeConfirm = true;
    }

    private async Task ConfirmResumeFromHere()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _showResumeConfirm = false;
            Session.ResumeFromHere();
            await OnStateChanged.InvokeAsync();
            await OnResumed.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}

@namespace Masterwork.App.Shared.Chrome
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services
@inject IAppSettingsStore SettingsStore
@inject IAudioPlayer AudioPlayer
@inject AudioSettingsState AudioState
@inject GameSessionState Session
@inject KnownLanguagesService LanguageDirectory
@inject VoicePackService VoicePacks
@inject NarrationService Narration
@inject IJSRuntime JS
@inject NavigationManager Nav

@{ AppSettingsApplier.ReassertCulture(); }
<div class="mws-dialog-overlay">
    <div class="mws-dialog @(_view == View.Options ? "mws-options-dialog" : "mws-dialog--sm")">
        @switch (_view)
        {
            case View.Options:
                <label class="mws-options-row">
                    <span class="mws-options-label">@AppStrings.OptionsDialog_BgmVolume</span>
                    <div class="mws-options-controls">
                        <input type="range" class="mws-options-input" min="1" max="100" value="@((int)(_draft.BgmVolume * 100))"
                               @oninput="OnBgmVolumeInput" disabled="@_draft.BgmMuted" />
                        <span class="mws-options-value">@((int)(_draft.BgmVolume * 100))%</span>
                        <input type="checkbox" class="mws-mute-checkbox" checked="@_draft.BgmMuted" @onchange="OnBgmMutedChanged" />
                        <span class="mws-mute-label">@AppStrings.Common_Mute</span>
                    </div>
                </label>
                <label class="mws-options-row">
                    <span class="mws-options-label">@AppStrings.OptionsDialog_SfxVolume</span>
                    <div class="mws-options-controls">
                        <input type="range" class="mws-options-input" min="1" max="100" value="@((int)(_draft.SfxVolume * 100))"
                               @oninput="OnSfxVolumeInput" disabled="@_draft.SfxMuted" />
                        <span class="mws-options-value">@((int)(_draft.SfxVolume * 100))%</span>
                        <input type="checkbox" class="mws-mute-checkbox" checked="@_draft.SfxMuted" @onchange="OnSfxMutedChanged" />
                        <span class="mws-mute-label">@AppStrings.Common_Mute</span>
                    </div>
                </label>
                <label class="mws-options-row">
                    <span class="mws-options-label">@AppStrings.OptionsDialog_TextSize</span>
                    <div class="mws-options-controls">
                        <input type="range" class="mws-options-input" min="0" max="5" step="1" value="@_draft.TextSizeStep" @oninput="OnTextSizeInput" />
                        <span class="mws-options-value">@TextSizePercent(_draft.TextSizeStep)%</span>
                    </div>
                </label>

                @if (DialogContext == OptionsDialogContext.MainMenu)
                {
                    <label class="mws-options-row">
                        <span class="mws-options-label">@AppStrings.OptionsDialog_AppLanguage</span>
                        <div class="mws-options-controls">
                            <select value="@_draft.UiLocale" @onchange="OnUiLocaleChanged">
                                @foreach (var culture in AppUiCultures.Supported)
                                {
                                    <option value="@culture.Code">@culture.DisplayName</option>
                                }
                            </select>
                            <span class="mws-options-hint" title="@AppStrings.OptionsDialog_AppLanguageHint">ⓘ</span>
                        </div>
                    </label>

                    <label class="mws-options-row">
                        <span class="mws-options-label">@AppStrings.OptionsDialog_PreferredModuleLanguage</span>
                        <div class="mws-options-controls">
                            <select value="@(_draft.PreferredModuleLanguage ?? "")" @onchange="OnPreferredModuleLanguageChanged">
                                <option value="">@AppStrings.OptionsDialog_SameAsApp</option>
                                @foreach (var lang in ModuleLanguageChoices())
                                {
                                    <option value="@lang">@LanguageNames.Native(lang)</option>
                                }
                            </select>
                            <span class="mws-options-hint" title="@AppStrings.OptionsDialog_ModuleLanguageHint">ⓘ</span>
                        </div>
                    </label>
                }

                <label class="mws-options-row">
                    <span class="mws-options-label">@AppStrings.OptionsDialog_VoiceLanguage</span>
                    <div class="mws-options-controls">
                        @if (DialogContext == OptionsDialogContext.InGame)
                        {
                            @* This playthrough's voice: None, or a language narration is installed or offered in. *@
                            <select class="mws-voice-language" value="@(_sessionVoice ?? VoiceSelection.None)" @onchange="OnSessionVoiceChanged">
                                <option value="@VoiceSelection.None">@AppStrings.OptionsDialog_VoiceNone</option>
                                @foreach (var lang in _sessionVoiceLanguages)
                                {
                                    <option value="@lang">@LanguageNames.Native(lang)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <select class="mws-voice-language" value="@(_draft.VoiceLanguage ?? "")" @onchange="OnVoiceLanguageChanged">
                                <option value="">@AppStrings.OptionsDialog_VoiceBestMatch</option>
                                <option value="@VoiceSelection.SameAsText">@AppStrings.OptionsDialog_VoiceSameAsModule</option>
                                <option value="@VoiceSelection.None">@AppStrings.OptionsDialog_VoiceNone</option>
                                @foreach (var lang in VoiceLanguageChoices())
                                {
                                    <option value="@lang">@LanguageNames.Native(lang)</option>
                                }
                            </select>
                            <span class="mws-options-hint" title="@AppStrings.OptionsDialog_VoiceLanguageHint">ⓘ</span>
                        }
                    </div>
                </label>

                @if (DialogContext == OptionsDialogContext.InGame && DraftVoiceTracks() is { Count: > 0 } tracks)
                {
                    <label class="mws-options-row">
                        <span class="mws-options-label">@AppStrings.OptionsDialog_VoiceTrack</span>
                        <div class="mws-options-controls">
                            <select class="mws-voice-track" value="@DraftTrackId(tracks)" disabled="@(tracks.Count <= 1)" @onchange="OnVoiceTrackChanged">
                                @foreach (var track in tracks)
                                {
                                    <option value="@track.Id">@track.DisplayName(_draft.UiLocale)</option>
                                }
                            </select>
                        </div>
                    </label>
                }

                <div class="mws-dialog-actions">
                    <ChromeButton class="style-btn-green" disabled="@_busy" OnClick="Apply">@AppStrings.Common_Apply</ChromeButton>
                    <ChromeButton class="style-btn-red" OnClick="Cancel">@AppStrings.Common_Cancel</ChromeButton>
                </div>
                break;

            case View.QuitConfirm:
                <h3>@AppStrings.OptionsDialog_QuitConfirmTitle</h3>
                <p>@AppStrings.OptionsDialog_QuitConfirmBody</p>
                <div class="mws-dialog-actions">
                    <ChromeButton class="mws-quit-button mws-btn-sm style-btn-red" disabled="@_busy" OnClick="AbandonGame">@AppStrings.OptionsDialog_AbandonGame</ChromeButton>
                    <ChromeButton class="mws-btn-sm style-btn-green" OnClick="BeginSaveAndQuit">@AppStrings.OptionsDialog_SaveAndQuit</ChromeButton>
                    <ChromeButton class="mws-btn-sm style-btn-brown" OnClick="CancelQuitConfirm">@AppStrings.Common_Cancel</ChromeButton>
                </div>
                break;

            case View.QuitNamePrompt:
                <h3>@AppStrings.OptionsDialog_NameSaveTitle</h3>
                <input type="text" @bind="_saveName" @bind:event="oninput" class="mws-save-name-input" />
                <div class="mws-dialog-actions">
                    <ChromeButton class="mws-btn-sm style-btn-green" disabled="@_busy" OnClick="ConfirmSaveAndQuit">@AppStrings.Common_Save</ChromeButton>
                    <ChromeButton class="mws-btn-sm style-btn-brown" OnClick="() => _view = View.QuitConfirm">@AppStrings.Common_Cancel</ChromeButton>
                </div>
                break;
        }
    </div>
</div>
<VoicePackPrompt @ref="_voicePrompt" InGame="true" />

@code {
    private enum View { Options, QuitConfirm, QuitNamePrompt }

    /// <summary>Which footer action to show — see <see cref="OptionsDialogContext"/>.</summary>
    [Parameter, EditorRequired]
    public OptionsDialogContext DialogContext { get; set; }

    /// <summary>Invoked when the dialog should close (Apply, Cancel, or after a quit action completes).</summary>
    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    /// <summary>Invoked with the chosen name once "Save and Quit" is confirmed — <see cref="OptionsDialogContext.InGame"/> only.</summary>
    [Parameter]
    public EventCallback<string> OnSaveAndQuit { get; set; }

    /// <summary>Invoked when "Abandon Game" is confirmed — <see cref="OptionsDialogContext.InGame"/> only.</summary>
    [Parameter]
    public EventCallback OnAbandonGame { get; set; }

    /// <summary>Prefilled name for the "Save and Quit" prompt — typically <c>"{townname} — {date}"</c>.</summary>
    [Parameter]
    public string DefaultSaveName { get; set; } = "";

    /// <summary>
    /// Opens straight into the Quit confirmation view instead of the ordinary Options view — used
    /// by <c>Play.razor</c>'s navigation-error recovery prompt, which only wants the Save-and-Quit/
    /// Abandon choice, not the audio/text-size settings. <see cref="OptionsDialogContext.InGame"/>
    /// only. When set, Cancel from that view closes the dialog entirely instead of falling back to
    /// the (in this case never-shown) Options view.
    /// </summary>
    [Parameter]
    public bool StartAtQuit { get; set; }

    private View _view = View.Options;
    private AppSettings _draft = AppSettings.Default;

    // Captured once, right after loading — Cancel reverts live audio back to this rather than
    // whatever the last-dragged slider left it at (see AudioSettingsState's own remarks on why
    // volume/mute are pushed live instead of waiting for Apply).
    private AppSettings _original = AppSettings.Default;

    private string _saveName = "";
    private KnownLanguages _known = new([], []);

    // Guards Apply/ConfirmSaveAndQuit/AbandonGame against a double-click re-invoking them before
    // the first invocation's re-render disables the button — see RenderedLinkView's HandleClick for
    // why a plain bool set before the first await is sufficient under Blazor's cooperative event
    // dispatch. Matters most for the quit actions, which commit a save or discard progress via
    // Play.razor's SaveAndQuit/AbandonGame.
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        if (StartAtQuit)
        {
            _view = View.QuitConfirm;
        }

        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _draft = await SettingsStore.LoadAsync();
        _original = _draft;
        _known = await LanguageDirectory.LoadAsync();
        if (DialogContext == OptionsDialogContext.InGame && Session.ModuleId is { } moduleId)
        {
            ResetSessionVoice();
            _sessionVoiceLanguages = [.. (await VoicePacks.VoiceLanguagesAsync(moduleId))
                .Concat(Session.Voices.Select(v => v.Track.Language))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(LanguageNames.Native, StringComparer.CurrentCultureIgnoreCase)];
        }
    }

    private VoicePackPrompt? _voicePrompt;

    // In game: the voice language and track picked for this playthrough, starting from what is
    // playing (None when nothing is). Applying changes the playthrough's voice, never the global setting.
    private string? _sessionVoice;
    private string? _sessionTrackId;
    private IReadOnlyList<string> _sessionVoiceLanguages = [];

    private void ResetSessionVoice()
    {
        _sessionVoice = Session.Voice?.Track.Language;
        _sessionTrackId = Session.Voice?.Track.Id;
    }

    // Every known language, plus the current choice so it stays selectable.
    private IEnumerable<string> ModuleLanguageChoices() => WithChoice(_known.Text, _draft.PreferredModuleLanguage);

    // Every known voice language, plus the current choice.
    private IEnumerable<string> VoiceLanguageChoices() =>
        WithChoice(_known.Voice, _draft.VoiceLanguage is VoiceSelection.None or VoiceSelection.SameAsText ? null : _draft.VoiceLanguage);

    private static IEnumerable<string> WithChoice(IEnumerable<string> languages, string? chosen) =>
        (chosen is null ? languages : languages.Append(chosen))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(LanguageNames.Native, StringComparer.CurrentCultureIgnoreCase);

    private static bool SameLanguage(string? a, string? b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<Masterwork.ModuleFormat.VoiceTrack> DraftVoiceTracks() =>
        _sessionVoice is { } language
            ? [.. Session.Voices.Select(v => v.Track).Where(t => SameLanguage(t.Language, language))]
            : [];

    private string? DraftTrackId(IReadOnlyList<Masterwork.ModuleFormat.VoiceTrack> tracks) =>
        Session.ModuleId is { } moduleId && tracks.Count > 0
            ? VoiceSelection.SelectTrack(tracks[0].Language, tracks, _sessionTrackId ?? VoiceSelection.PreferredTrackId(_draft, moduleId, tracks[0].Language))?.Id
            : null;

    private void OnVoiceLanguageChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _draft = _draft with { VoiceLanguage = string.IsNullOrEmpty(value) ? null : value };
    }

    private void OnSessionVoiceChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _sessionVoice = string.IsNullOrEmpty(value) || value == VoiceSelection.None ? null : value;
        _sessionTrackId = null;
    }

    // The track picked is also remembered for the module, to preselect next time.
    private void OnVoiceTrackChanged(ChangeEventArgs e)
    {
        if (Session.ModuleId is { } moduleId && DraftVoiceTracks() is { Count: > 0 } tracks && e.Value?.ToString() is { Length: > 0 } trackId)
        {
            _sessionTrackId = trackId;
            _draft = VoiceSelection.WithTrackPreference(_draft, moduleId, tracks[0].Language, trackId);
        }
    }

    private bool SessionVoiceChanged() =>
        !SameLanguage(_sessionVoice, Session.Voice?.Track.Language) || _sessionTrackId != Session.Voice?.Track.Id;

    // In game, a voice language whose pack isn't installed asks first. Declining resets the voice
    // and leaves the dialog open, with nothing applied.
    private async Task<SessionVoice?> ConfirmSessionVoiceAsync(string moduleId)
    {
        var voice = new SessionVoice(_sessionVoice, _sessionTrackId);
        if (SameLanguage(_sessionVoice, Session.Voice?.Track.Language))
        {
            return voice;
        }

        if (await _voicePrompt!.ConfirmAsync(moduleId, null, voice) is not { } confirmed)
        {
            ResetSessionVoice();
            return null;
        }

        // Picks up the tracks of a pack just downloaded.
        await Narration.ActivateAsync();
        return confirmed;
    }

    // Volume/mute changes are pushed live (immediately audible while dragging/toggling), not just
    // staged into _draft for Apply — see AudioSettingsState's own remarks. Text size and locale stay
    // draft-only; there's no live-preview need for either.
    private async Task OnBgmVolumeInput(ChangeEventArgs e)
    {
        _draft = _draft with { BgmVolume = ParsePercent(e.Value) };
        await AppSettingsApplier.ApplyAudioAsync(_draft, AudioPlayer, AudioState);
    }

    private async Task OnSfxVolumeInput(ChangeEventArgs e)
    {
        _draft = _draft with { SfxVolume = ParsePercent(e.Value) };
        await AppSettingsApplier.ApplyAudioAsync(_draft, AudioPlayer, AudioState);
    }

    private void OnTextSizeInput(ChangeEventArgs e) => _draft = _draft with { TextSizeStep = ParseInt(e.Value, _draft.TextSizeStep) };

    // Mirrors wwwroot/appSettings.js's own SCALES array exactly — the step index itself is
    // meaningless to a player, but the actual --mws-text-scale percentage it drives is.
    private static readonly int[] TextSizeStepPercents = [80, 90, 100, 115, 130, 150];
    private static int TextSizePercent(int step) => TextSizeStepPercents[Math.Clamp(step, 0, TextSizeStepPercents.Length - 1)];
    private void OnUiLocaleChanged(ChangeEventArgs e) => _draft = _draft with { UiLocale = e.Value?.ToString() ?? AppUiCultures.Default };

    private void OnPreferredModuleLanguageChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _draft = _draft with { PreferredModuleLanguage = string.IsNullOrEmpty(value) ? null : value };
    }

    private async Task OnBgmMutedChanged(ChangeEventArgs e)
    {
        _draft = _draft with { BgmMuted = e.Value is true };
        await AppSettingsApplier.ApplyAudioAsync(_draft, AudioPlayer, AudioState);
    }

    private async Task OnSfxMutedChanged(ChangeEventArgs e)
    {
        _draft = _draft with { SfxMuted = e.Value is true };
        await AppSettingsApplier.ApplyAudioAsync(_draft, AudioPlayer, AudioState);
    }

    private static double ParsePercent(object? value) =>
        double.TryParse(value?.ToString(), out var pct) ? pct / 100.0 : 1.0;

    private static int ParseInt(object? value, int fallback) =>
        int.TryParse(value?.ToString(), out var i) ? i : fallback;

    private async Task Apply()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            // Left alone unless the voice was changed here, so a playthrough's stored voice that
            // isn't playing (its pack removed) survives an Apply made for something else.
            SessionVoice? sessionVoice = null;
            if (DialogContext == OptionsDialogContext.InGame && Session.ModuleId is { } moduleId && SessionVoiceChanged())
            {
                sessionVoice = await ConfirmSessionVoiceAsync(moduleId);
                if (sessionVoice is null)
                {
                    return;
                }
            }

            await SettingsStore.SaveAsync(_draft);
            // Volume/mute are already live (pushed on every prior slider/checkbox change) — this
            // re-applies them too (harmless, idempotent), and is what actually applies culture/text
            // size, which stayed draft-only until now.
            await AppSettingsApplier.ApplyAsync(_draft, AudioPlayer, AudioState, JS);
            if (sessionVoice is not null)
            {
                await Narration.ChooseAsync(sessionVoice);
            }

            await OnClose.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Cancel()
    {
        // Volume/mute may have been live-pushed by a slider drag or mute toggle the player then
        // backed out of — revert to whatever was in effect before this dialog opened, or "Cancel"
        // would silently leave those changes in effect anyway.
        await AppSettingsApplier.ApplyAudioAsync(_original, AudioPlayer, AudioState);
        await OnClose.InvokeAsync();
    }

    private void BeginSaveAndQuit()
    {
        _saveName = DefaultSaveName;
        _view = View.QuitNamePrompt;
    }

    private async Task CancelQuitConfirm()
    {
        if (StartAtQuit)
        {
            await OnClose.InvokeAsync();
            return;
        }

        _view = View.Options;
    }

    private async Task ConfirmSaveAndQuit()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await OnSaveAndQuit.InvokeAsync(_saveName);
            await OnClose.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AbandonGame()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await OnAbandonGame.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}

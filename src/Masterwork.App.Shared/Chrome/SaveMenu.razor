@namespace Masterwork.App.Shared.Chrome
@using System.Text.Json
@using Masterwork.App.Shared.Services
@using Masterwork.Engine
@using Masterwork.Engine.Session
@inject ISaveStore Store

<div class="mws-save-menu">
    <h4>Save / Load</h4>
    @for (var i = 0; i < SlotCount; i++)
    {
        var slot = i;
        <div class="mws-save-slot">
            <span>Slot @(slot + 1)</span>
            <button type="button" @onclick="() => Save(slot)">Save</button>
            <button type="button" disabled="@(!_hasSave[slot])" @onclick="() => Load(slot)">Load</button>
            <button type="button" disabled="@(!_hasSave[slot])" @onclick="() => Export(slot)">Export</button>
        </div>
    }
</div>

@code {
    /// <summary>The current session state — read to save, replaced (via <see cref="GameSessionState.Start"/>) on load.</summary>
    [Parameter, EditorRequired]
    public GameSessionState State { get; set; } = null!;

    /// <summary>Invoked after a slot is loaded (the active session changed).</summary>
    [Parameter]
    public EventCallback OnStateChanged { get; set; }

    private const int SlotCount = 3;
    private readonly bool[] _hasSave = new bool[SlotCount];

    protected override async Task OnInitializedAsync()
    {
        // See the same guard in SessionSetup.razor: ISaveStore may use IJSRuntime, which throws
        // during server-side static prerendering.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        for (var i = 0; i < SlotCount; i++)
        {
            _hasSave[i] = await Store.HasSaveAsync(i);
        }
    }

    private async Task Save(int slot)
    {
        if (State.Session is null)
        {
            return;
        }

        var json = JsonSerializer.Serialize(State.Session.Serialize());
        await Store.SaveAsync(slot, json);
        _hasSave[slot] = true;
    }

    private async Task Load(int slot)
    {
        if (State.Module is null)
        {
            return;
        }

        var json = await Store.LoadAsync(slot);
        if (json is null)
        {
            return;
        }

        var save = JsonSerializer.Deserialize<SessionSave>(json);
        if (save is null)
        {
            return;
        }

        var session = GameSession.Restore(State.Module, save);
        State.Start(State.Module, session);
        await OnStateChanged.InvokeAsync();
    }

    private async Task Export(int slot)
    {
        var json = await Store.LoadAsync(slot);
        if (json is null)
        {
            return;
        }

        await Store.ExportAsync(slot, $"masterwork-save-{slot + 1}.json", json);
    }
}

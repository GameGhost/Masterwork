@page "/modules/manage"
@using Masterwork.App.Shared.Services
@inject IModuleStore ModuleStore
@inject ISaveStore SaveStore
@inject NavigationManager Nav

<PageTitle>Masterwork — Manage Modules</PageTitle>

<button type="button" class="mws-back-button" @onclick='() => Nav.NavigateTo("/")'>◀ Back</button>

<div class="mws-manage-modules">
    <h2>Manage Modules</h2>

    @foreach (var module in _modules)
    {
        <div class="mws-module-row">
            <div>
                <strong>@module.Title</strong>
                <span class="mws-module-version">v@module.Version</span>
                @if (module.IsBuiltIn)
                {
                    <span class="mws-badge">Built-in</span>
                }
            </div>
            @if (module.IsBuiltIn)
            {
                <span class="mws-empty-state">Ships with the app — can't be removed.</span>
            }
            else
            {
                <button type="button" @onclick="() => _confirmingDeleteId = module.ModuleId">Delete</button>
            }
        </div>
    }
</div>

@if (_confirmingDeleteId is not null)
{
    <div class="mws-dialog-overlay">
        <div class="mws-dialog">
            <h3>Delete this module?</h3>
            <p>Also delete this module's saves?</p>
            <div class="mws-dialog-actions">
                <button type="button" @onclick="() => ConfirmDelete(_confirmingDeleteId, deleteSaves: true)">Delete module + saves</button>
                <button type="button" @onclick="() => ConfirmDelete(_confirmingDeleteId, deleteSaves: false)">Delete module only</button>
                <button type="button" @onclick="() => _confirmingDeleteId = null">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<InstalledModule> _modules = [];
    private string? _confirmingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _modules = await ModuleStore.ListAsync();
    }

    private async Task ConfirmDelete(string? moduleId, bool deleteSaves)
    {
        if (moduleId is null)
        {
            return;
        }

        // Dependency-asset-pack reference counting (don't free a shared pack's storage while
        // another installed module still depends on it) is still a TODO — it doesn't matter yet
        // since real modules don't declare dependencies against anything installable until asset
        // packs exist (Milestone C), but it needs solving before that changes.
        await ModuleStore.DeleteAsync(moduleId);

        if (deleteSaves)
        {
            var saves = await SaveStore.ListAsync();
            foreach (var save in saves.Where(s => s.ModuleId == moduleId))
            {
                await SaveStore.DeleteAsync(save.Id);
            }
        }

        _confirmingDeleteId = null;
        _modules = await ModuleStore.ListAsync();
    }
}

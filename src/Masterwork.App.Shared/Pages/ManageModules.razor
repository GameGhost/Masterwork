@page "/modules/manage"
@using Masterwork.App.Shared.Chrome
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services
@using Masterwork.ModuleFormat
@inject IModuleStore ModuleStore
@inject IAssetPackStore AssetPackStore
@inject ISaveStore SaveStore
@inject NavigationManager Nav
@inject IJSRuntime JS

@{ AppSettingsApplier.ReassertCulture(); }
<PageTitle>@AppStrings.ManageModules_PageTitle</PageTitle>

<div class="mws-scenario-screen">
    <div class="mws-scenario-border" aria-hidden="true"></div>
    <ChromeButton class="mws-scenario-back-button" OnClick='() => Nav.NavigateTo("/")'>
        <span class="mws-visually-hidden">@AppStrings.Common_Back</span>
    </ChromeButton>

    <h2 class="mws-screen-title">@AppStrings.ManageModules_Heading</h2>

    <div class="mws-manage-modules">
        @foreach (var module in _modules)
        {
            <div class="mws-module-row">
                <div class="mws-module-row-info">
                    <strong>@module.Title</strong>
                    <span class="mws-module-version">v@(module.Version)</span>
                </div>
                <ChromeButton class="mws-btn-sm style-btn-red" OnClick="() => _confirmingDeleteId = module.ModuleId">@AppStrings.Common_Delete</ChromeButton>
            </div>
        }
    </div>

    <h2 class="mws-screen-title">@AppStrings.ManageModules_AssetPacksHeading</h2>

    <div class="mws-module-toolbar">
        <label for="mws-upload-asset-pack-input" class="mws-upload-button style-btn-brown">@AppStrings.ManageModules_UploadAssetPack</label>
        <InputFile id="mws-upload-asset-pack-input" class="mws-visually-hidden" OnChange="OnAssetPackFileSelected"
                   accept=".mwassets,application/zip,application/x-zip-compressed,application/octet-stream" />
    </div>
    @if (_assetPackUploadError is not null)
    {
        <p class="mws-version-warning">@_assetPackUploadError</p>
    }

    <div class="mws-manage-modules">
        @foreach (var pack in _assetPacks)
        {
            <div class="mws-module-row">
                <div class="mws-module-row-info">
                    <strong>@pack.Title</strong>
                    <span class="mws-module-version">v@(pack.Version)</span>
                    <span class="mws-module-version">
                        @(pack.InstallSource == AssetPackInstallSource.Auto ? AppStrings.ManageModules_AssetPackSource_Auto : AppStrings.ManageModules_AssetPackSource_Manual)
                    </span>
                </div>
                @if (!AssetPackDependencyGuard.HasDependent(_modules, pack.AssetPackId, pack.Version))
                {
                    <ChromeButton class="mws-btn-sm style-btn-red" OnClick="() => _confirmingDeleteAssetPack = pack">@AppStrings.Common_Delete</ChromeButton>
                }
            </div>
        }
    </div>

    @if (_confirmingDeleteId is not null)
    {
        <div class="mws-dialog-overlay">
            <div class="mws-dialog mws-dialog--sm">
                <h3>@AppStrings.ManageModules_ConfirmTitle</h3>
                <p>@AppStrings.ManageModules_ConfirmBody</p>
                <div class="mws-dialog-actions">
                    <ChromeButton class="mws-btn-sm style-btn-green" disabled="@_loading" OnClick="() => ConfirmDelete(_confirmingDeleteId, deleteSaves: false)">@AppStrings.ManageModules_DeleteModuleOnly</ChromeButton>
                    <ChromeButton class="mws-btn-sm style-btn-red" disabled="@_loading" OnClick="() => ConfirmDelete(_confirmingDeleteId, deleteSaves: true)">@AppStrings.ManageModules_DeleteWithSaves</ChromeButton>
                    <ChromeButton class="mws-btn-sm style-btn-brown" OnClick="() => _confirmingDeleteId = null">@AppStrings.Common_Cancel</ChromeButton>
                </div>
            </div>
        </div>
    }

    @if (_confirmingDeleteAssetPack is not null)
    {
        <div class="mws-dialog-overlay">
            <div class="mws-dialog mws-dialog--sm">
                <h3>@AppStrings.ManageModules_AssetPackDeleteConfirmTitle</h3>
                <p>@AppStrings.ManageModules_AssetPackDeleteConfirmBody</p>
                <div class="mws-dialog-actions">
                    <ChromeButton class="mws-btn-sm style-btn-red" disabled="@_loading" OnClick="ConfirmDeleteAssetPack">@AppStrings.Common_Delete</ChromeButton>
                    <ChromeButton class="mws-btn-sm style-btn-brown" OnClick="() => _confirmingDeleteAssetPack = null">@AppStrings.Common_Cancel</ChromeButton>
                </div>
            </div>
        </div>
    }

    @if (_pendingAssetPackInstall is not null)
    {
        <div class="mws-dialog-overlay">
            <div class="mws-dialog mws-dialog--sm">
                <h3>@AppStrings.ManageModules_AssetPackHashMismatchTitle</h3>
                <p>@AppStrings.ManageModules_AssetPackHashMismatchBody</p>
                <div class="mws-dialog-actions">
                    <ChromeButton class="mws-btn-sm style-btn-green" disabled="@_loading" OnClick="ConfirmPendingAssetPackInstall">@AppStrings.ManageModules_InstallAnyway</ChromeButton>
                    <ChromeButton class="mws-btn-sm style-btn-brown" OnClick="() => _pendingAssetPackInstall = null">@AppStrings.Common_Cancel</ChromeButton>
                </div>
            </div>
        </div>
    }

    <LoadingOverlay Show="@_loading" Message="@AppStrings.Common_Loading" />
</div>

@code {
    private IReadOnlyList<InstalledModule> _modules = [];
    private IReadOnlyList<InstalledAssetPack> _assetPacks = [];
    private string? _confirmingDeleteId;
    private InstalledAssetPack? _confirmingDeleteAssetPack;
    private (byte[] Bytes, string Sha256)? _pendingAssetPackInstall;
    private string? _assetPackUploadError;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _loading = true;
        try
        {
            _modules = await ModuleStore.ListAsync();
            _assetPacks = await AssetPackStore.ListAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    // See this method's own equivalent on StartNewGame.razor for why _loading doubles as a
    // re-entrancy guard here.
    private async Task ConfirmDelete(string? moduleId, bool deleteSaves)
    {
        if (_loading || moduleId is null)
        {
            return;
        }

        _loading = true;
        try
        {
            var deletedModule = _modules.FirstOrDefault(m => m.ModuleId == moduleId);
            await ModuleStore.DeleteAsync(moduleId);

            if (deleteSaves)
            {
                var saves = await SaveStore.ListAsync();
                foreach (var save in saves.Where(s => s.ModuleId == moduleId))
                {
                    await SaveStore.DeleteAsync(save.Id);
                }
            }

            _confirmingDeleteId = null;
            _modules = await ModuleStore.ListAsync();

            // Auto-installed dependencies this module was the last one holding onto get cleaned up
            // too — a manually-installed pack, or one still depended on by another module, is left
            // alone (see AssetPackDependencyGuard/AssetPackInstallSource).
            if (deletedModule is not null)
            {
                foreach (var dependency in deletedModule.Dependencies)
                {
                    if (dependency.Version is null || AssetPackDependencyGuard.HasDependent(_modules, dependency.Id, dependency.Version))
                    {
                        continue;
                    }

                    var pack = _assetPacks.FirstOrDefault(p => p.AssetPackId == dependency.Id && p.Version == dependency.Version);
                    if (pack is { InstallSource: AssetPackInstallSource.Auto })
                    {
                        await AssetPackStore.DeleteAsync(pack.AssetPackId, pack.Version);
                    }
                }

                _assetPacks = await AssetPackStore.ListAsync();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ConfirmDeleteAssetPack()
    {
        if (_loading || _confirmingDeleteAssetPack is not { } pack)
        {
            return;
        }

        _loading = true;
        try
        {
            await AssetPackStore.DeleteAsync(pack.AssetPackId, pack.Version);
            _confirmingDeleteAssetPack = null;
            _assetPacks = await AssetPackStore.ListAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnAssetPackFileSelected(InputFileChangeEventArgs e)
    {
        _assetPackUploadError = null;
        byte[] bytes;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            bytes = memory.ToArray();
        }
        catch (Exception ex)
        {
            _assetPackUploadError = string.Format(AppStrings.EffectiveCulture, AppStrings.ManageModules_AssetPackUploadError_Generic, ex.Message);
            return;
        }

        await ProcessAssetPackUploadAsync(bytes);
    }

    private async Task ProcessAssetPackUploadAsync(byte[] bytes)
    {
        var manifestYaml = AssetPackPackage.ReadManifestOnly(bytes);
        if (manifestYaml is null)
        {
            _assetPackUploadError = AppStrings.ManageModules_AssetPackUploadError_NoManifest;
            return;
        }

        _loading = true;
        string sha256;
        try
        {
            sha256 = await ModuleHasher.ComputeHashAsync(bytes, js: JS);
        }
        finally
        {
            _loading = false;
        }

        var manifest = new AssetPackManifestParser().Parse(manifestYaml);
        var existing = _assetPacks.FirstOrDefault(p => p.AssetPackId == manifest.Id && p.Version == manifest.Version);

        switch (AssetPackManualInstall.Decide(existing, sha256))
        {
            case AssetPackManualInstallDecision.ConfirmHashMismatch:
                _pendingAssetPackInstall = (bytes, sha256);
                break;
            default:
                await InstallAssetPackAsync(bytes, sha256);
                break;
        }
    }

    private async Task ConfirmPendingAssetPackInstall()
    {
        if (_pendingAssetPackInstall is not { } pending)
        {
            return;
        }

        _pendingAssetPackInstall = null;
        await InstallAssetPackAsync(pending.Bytes, pending.Sha256);
    }

    private async Task InstallAssetPackAsync(byte[] bytes, string sha256)
    {
        _loading = true;
        try
        {
            await AssetPackStore.InstallAsync(bytes, sha256, AssetPackInstallSource.Manual);
            _assetPacks = await AssetPackStore.ListAsync();
        }
        catch (Exception ex)
        {
            _assetPackUploadError = string.Format(AppStrings.EffectiveCulture, AppStrings.ManageModules_AssetPackUploadError_Generic, ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}

@page "/achievements"
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services
@inject IModuleStore ModuleStore
@inject NavigationManager Nav

@{ AppSettingsApplier.ReassertCulture(); }
<PageTitle>@AppStrings.Achievements_PageTitle</PageTitle>

<button type="button" class="mws-back-button" @onclick='() => Nav.NavigateTo("/")'>@AppStrings.Common_Back</button>

<div class="mws-achievements">
    <nav class="mws-tabs">
        <button type="button" class="@(_tab == Tab.Achievements ? "selected" : "")" @onclick="() => _tab = Tab.Achievements">@AppStrings.Achievements_Tab_Achievements</button>
        <button type="button" class="@(_tab == Tab.Memories ? "selected" : "")" @onclick="() => _tab = Tab.Memories">@AppStrings.Achievements_Tab_Memories</button>
    </nav>

    @if (_tab == Tab.Achievements)
    {
        <div class="mws-achievements-by-module">
            @if (_modules.Count == 0)
            {
                <p>@AppStrings.Achievements_NoModules</p>
            }
            else
            {
                @foreach (var module in _modules)
                {
                    <section class="mws-achievement-module">
                        <h4>@module.Title</h4>
                        <p class="mws-empty-state">@AppStrings.Achievements_NoneForModule</p>
                    </section>
                }
            }
        </div>
    }
    else
    {
        <div class="mws-memories">
            <p class="mws-empty-state">@AppStrings.Achievements_NoMemories</p>
        </div>
    }
</div>

@code {
    private enum Tab { Achievements, Memories }

    private Tab _tab = Tab.Achievements;
    private IReadOnlyList<InstalledModule> _modules = [];

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _modules = await ModuleStore.ListAsync();
    }
}

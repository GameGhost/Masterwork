@page "/continue"
@using System.Text.Json
@using Masterwork.App.Shared.Chrome
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services
@using Masterwork.Engine.Session
@using Microsoft.Extensions.Logging
@inject ISaveStore SaveStore
@inject IModuleStore ModuleStore
@inject GameSessionState State
@inject IAudioPlayer AudioPlayer
@inject IModuleStyleInjector StyleInjector
@inject NavigationManager Nav
@inject ILogger<GameSession> GameSessionLogger
@inject ILogger<ContinueList> Logger
@inject INativeFilePicker FilePicker
@inject IJSRuntime JS

@{ AppSettingsApplier.ReassertCulture(); }
<PageTitle>@AppStrings.ContinueList_PageTitle</PageTitle>

<div class="mws-scenario-screen">
    <div class="mws-scenario-border" aria-hidden="true"></div>
    <ChromeButton class="mws-scenario-back-button" OnClick='() => Nav.NavigateTo("/")'>
        <span class="mws-visually-hidden">@AppStrings.Common_Back</span>
    </ChromeButton>

    <div class="mws-module-toolbar">
        @if (FilePicker.IsAvailable)
        {
            <ChromeButton class="mws-upload-button mws-import-save-button style-btn-brown" disabled="@_busy" OnClick="OnNativePickerClicked">@AppStrings.ContinueList_ImportSave</ChromeButton>
        }
        else
        {
            <label for="mws-import-input" class="mws-upload-button mws-import-save-button style-btn-brown">@AppStrings.ContinueList_ImportSave</label>
            <InputFile id="mws-import-input" class="mws-visually-hidden" OnChange="OnUploadFileSelected" accept=".mwsave" />
        }
    </div>
    @if (_importError is not null)
    {
        <p class="mws-version-warning">@_importError</p>
    }

    <h2 class="mws-screen-title">@AppStrings.ContinueList_Heading</h2>

    <div class="mws-continue-list">
        @if (_saves.Count == 0)
        {
            <p class="mws-continue-empty">@AppStrings.ContinueList_Empty</p>
        }
        else
        {
            @foreach (var save in _saves.OrderByDescending(s => s.LastPlayedUtc))
            {
                var installed = _modulesById.GetValueOrDefault(save.ModuleId);
                var moduleTitle = installed?.Title ?? save.ModuleId;
                var versionWarning = VersionWarning(save, installed);

                <div class="mws-save-row">
                    <div class="mws-save-info">
                        <strong>@(save.DisplayName ?? (save.IsAutosave ? AppStrings.Common_Autosave : AppStrings.ContinueList_UnnamedSave))</strong>
                        <span>@moduleTitle</span>
                        <span>@(save.LastStateLabel ?? "")</span>
                        <span class="mws-save-timestamp">@save.LastPlayedUtc.ToLocalTime().ToString("g", AppStrings.EffectiveCulture)</span>
                        @if (save.Language is not null)
                        {
                            <span class="mws-save-language">@save.Language</span>
                        }
                        @if (installed is null)
                        {
                            <span class="mws-version-warning">⚠ @AppStrings.ContinueList_ModuleMissing</span>
                        }
                        else if (versionWarning is not null)
                        {
                            <span class="mws-version-warning">⚠ @versionWarning</span>
                        }
                    </div>
                    <div class="mws-save-actions">
                        <ChromeButton class="mws-btn-sm style-btn-green" disabled="@(_busy || installed is null)"
                                title="@(installed is null ? AppStrings.ContinueList_ModuleMissingTitle : null)"
                                OnClick="() => Resume(save)">@AppStrings.Common_Resume</ChromeButton>
                        <ChromeButton class="mws-btn-sm style-btn-brown" disabled="@_busy" OnClick="() => Export(save)">@AppStrings.Common_Export</ChromeButton>
                        <ChromeButton class="mws-btn-sm style-btn-red" disabled="@_busy" OnClick="() => _pendingDelete = save">@AppStrings.Common_Delete</ChromeButton>
                    </div>
                </div>
            }
        }
    </div>

    @if (_pendingResume is not null)
    {
        var moduleTitle = _modulesById.GetValueOrDefault(_pendingResume.ModuleId)?.Title ?? _pendingResume.ModuleId;

        <div class="mws-dialog-overlay">
            <div class="mws-dialog mws-dialog--sm">
                <h3>@AppStrings.ContinueList_ResumeConfirmTitle</h3>
                <p>@string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_ResumeConfirmBody, moduleTitle)</p>
                <div class="mws-dialog-actions">
                    <ChromeButton class="mws-btn-sm style-btn-green" disabled="@_busy" OnClick="() => ConfirmResume(_pendingResume)">@AppStrings.ContinueList_ResumeAnyway</ChromeButton>
                    <ChromeButton class="mws-btn-sm style-btn-brown" OnClick="() => _pendingResume = null">@AppStrings.Common_Cancel</ChromeButton>
                </div>
            </div>
        </div>
    }

    @if (_pendingDelete is not null)
    {
        <div class="mws-dialog-overlay">
            <div class="mws-dialog mws-dialog--sm">
                <h3>@AppStrings.ContinueList_DeleteConfirmTitle</h3>
                <p>@AppStrings.ContinueList_DeleteConfirmBody</p>
                <div class="mws-dialog-actions">
                    <ChromeButton class="mws-btn-sm style-btn-red" disabled="@_busy" OnClick="() => Delete(_pendingDelete)">@AppStrings.Common_Yes</ChromeButton>
                    <ChromeButton class="mws-btn-sm style-btn-brown" OnClick="() => _pendingDelete = null">@AppStrings.Common_No</ChromeButton>
                </div>
            </div>
        </div>
    }

    @if (_pendingImport is not null)
    {
        <div class="mws-dialog-overlay">
            <div class="mws-dialog mws-dialog--sm">
                <h3>@AppStrings.ContinueList_ImportConfirmTitle</h3>
                <p>@_pendingImport.Message</p>
                <div class="mws-dialog-actions">
                    <ChromeButton class="mws-btn-sm style-btn-green" disabled="@_busy" OnClick="ConfirmPendingImport">@AppStrings.Common_Yes</ChromeButton>
                    <ChromeButton class="mws-btn-sm style-btn-brown" OnClick="() => _pendingImport = null">@AppStrings.Common_No</ChromeButton>
                </div>
            </div>
        </div>
    }

    @if (_resumeError is not null)
    {
        <div class="mws-dialog-overlay">
            <div class="mws-dialog mws-dialog--sm">
                <h3>@AppStrings.ContinueList_ResumeErrorTitle</h3>
                <p>@_resumeError</p>
                <div class="mws-dialog-actions">
                    <ChromeButton class="mws-btn-sm style-btn-brown" OnClick="() => _resumeError = null">@AppStrings.Common_Ok</ChromeButton>
                </div>
            </div>
        </div>
    }

    <LoadingOverlay Show="@_loading" Message="@_loadingMessage" Done="@_loadingDone" Total="@_loadingTotal" />
</div>

@code {
    private sealed record PendingImport(SaveExport Export, string Message);

    private List<SaveEntry> _saves = [];
    private Dictionary<string, InstalledModule> _modulesById = [];
    private SaveEntry? _pendingResume;
    private SaveEntry? _pendingDelete;
    private PendingImport? _pendingImport;
    private string? _resumeError;
    private string? _importError;
    private bool _loading;
    private string _loadingMessage = "";
    private int? _loadingDone;
    private int? _loadingTotal;

    // Guards ConfirmResume/Export/Delete/the import handlers against a double-click re-invoking one
    // of them before the first invocation's re-render disables the buttons -- see
    // RenderedLinkView.HandleClick for why a plain bool set before the first await is sufficient
    // under Blazor's cooperative event dispatch. Resume() itself doesn't need its own check: it's
    // synchronous except for a tail call into ConfirmResume, so guarding ConfirmResume alone already
    // covers a double-click on Resume.
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _saves = [.. await SaveStore.ListAsync()];
        var modules = await ModuleStore.ListAsync();
        _modulesById = modules.ToDictionary(m => m.ModuleId);
    }

    // Warns in two directions: the save was made with a *newer* module version than what's
    // installed now (the module may have been downgraded, or the save came from elsewhere), or the
    // installed module has moved on by a major/minor version since the save was made (a patch-only
    // difference isn't flagged — that's not expected to break compatibility on its own).
    private static string? VersionWarning(SaveEntry save, InstalledModule? installed)
    {
        if (installed is null)
        {
            return null;
        }

        var comparison = SemVer.Compare(save.ModuleVersion, installed.Version);
        if (comparison > 0)
        {
            return string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_VersionWarning_Newer, save.ModuleVersion, installed.Version);
        }

        if (comparison < 0 && SemVer.MajorOrMinorDiffers(save.ModuleVersion, installed.Version))
        {
            return string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_VersionWarning_Moved, save.ModuleVersion, installed.Version);
        }

        return null;
    }

    // Only warns when resuming this save would actually clobber *newer* progress sitting in that
    // module's autosave — once play resumes, PersistAutosaveAsync (Play.razor) starts overwriting
    // the module's autosave with this save's progress. Nothing is lost by resuming a save that's
    // itself the autosave, or one that's already at least as recent as the autosave (a manual save
    // taken after the autosave supersedes it, same as Start New Game's own conflict check).
    private Task Resume(SaveEntry entry)
    {
        _resumeError = null;

        if (!_modulesById.ContainsKey(entry.ModuleId))
        {
            // The Resume button is disabled in this case (see the markup above) — this is just
            // defense in depth for a module uninstalled in the moment between page load and click.
            _resumeError = AppStrings.ContinueList_ResumeError_ModuleMissing;
            return Task.CompletedTask;
        }

        var autosave = _saves.FirstOrDefault(s => s.ModuleId == entry.ModuleId && s.IsAutosave);
        var wouldOverwriteNewerAutosave = !entry.IsAutosave && autosave is not null && autosave.LastPlayedUtc > entry.LastPlayedUtc;
        if (!wouldOverwriteNewerAutosave)
        {
            return ConfirmResume(entry);
        }

        _pendingResume = entry;
        return Task.CompletedTask;
    }

    private async Task ConfirmResume(SaveEntry entry)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _pendingResume = null;

        _loading = true;
        _loadingMessage = AppStrings.Common_Loading;
        _loadingDone = null;
        _loadingTotal = null;
        try
        {
            var json = await SaveStore.LoadAsync(entry.Id);
            if (json is null)
            {
                return;
            }

            var save = JsonSerializer.Deserialize<SessionSave>(json);
            if (save is null)
            {
                return;
            }

            var loaded = await ModuleStore.LoadAsync(entry.ModuleId, entry.Language);
            loaded = await PreloadAssetsAsync(loaded);
            var session = GameSession.Restore(loaded.Module, save, logger: GameSessionLogger);
            State.Start(entry.ModuleId, entry.ModuleVersion, entry.Language, loaded, session);
            await StyleInjector.ApplyAsync(loaded.StyleCss);
            // Stopped explicitly here rather than waiting for MainLayout's own route-change handler
            // to catch up a tick later — see MainLayout.SyncThemeMusicAsync's remarks.
            await AudioPlayer.StopBgmAsync();
            Nav.NavigateTo("/play");
        }
        catch (InvalidOperationException ex)
        {
            // Defense in depth — Resume() already checks this ahead of time, but this covers the
            // module being uninstalled in the moment between opening this page and clicking Resume.
            // ex.Message is an internal exception message (English, per the "behind the scenes
            // strings stay in code" rule) even though it surfaces in this user-facing dialog.
            _resumeError = string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_ResumeError_Exception, ex.Message);
        }
        catch (JsonException ex)
        {
            // A save from an incompatible/older save-format revision (see SnapshotKind's remarks
            // for a concrete example) — surfaced the same way as any other resume failure rather
            // than crashing the app on data the player can't do anything about.
            _resumeError = string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_ResumeError_Exception, ex.Message);
        }
        finally
        {
            _loading = false;
            _busy = false;
        }
    }

    // Fetches every asset the module ships before navigating to /play, with progress — a passage's
    // images/fonts are already resident by the time it first renders instead of popping in one at a
    // time as IAssetResolver's own lazy, per-reference fetches would otherwise complete. Mirrors
    // StartNewGame.razor's own PreloadAssetsAsync.
    private async Task<LoadedModuleContent> PreloadAssetsAsync(LoadedModuleContent loaded)
    {
        // The previous session's preloaded object URLs (if any) are no longer reachable once this
        // new module's Assets replaces GameSessionState.Assets — revoke them now rather than leaking
        // their backing blobs for the rest of the tab's lifetime.
        if (State.Assets is PreloadedModuleAssetSource previous)
        {
            await previous.RevokeAllAsync(JS);
        }

        _loadingMessage = AppStrings.Common_PreparingAssets;
        _loadingDone = null;
        _loadingTotal = null;
        var progress = new Progress<(int Done, int Total)>(p => ReportProgress(p, AppStrings.Common_PreparingAssetsPercent));
        return await loaded.WithPreloadedAssetsAsync(progress);
    }

    // Fires from Progress<T>'s posted continuation, not the calling method's own await chain, so it
    // needs its own StateHasChanged rather than relying on the caller's next render.
    private void ReportProgress((int Done, int Total) p, string percentFormat)
    {
        _loadingDone = p.Done;
        _loadingTotal = p.Total;
        var percent = p.Total > 0 ? (int)(100.0 * p.Done / p.Total) : 0;
        _loadingMessage = string.Format(AppStrings.EffectiveCulture, percentFormat, percent);
        StateHasChanged();
    }

    // Bundles the save's own SaveEntry metadata alongside its raw session JSON -- a bare SessionSave
    // blob (what SaveStore.LoadAsync returns) carries no module id/version/display name at all, so
    // without this wrapper an imported file would have nothing to validate against the importing
    // machine's installed modules. See SaveExport's own remarks.
    //
    // The autosave has no DisplayName of its own (SaveEntry's own remarks) -- exporting it with a
    // null name would both produce an unreadable id-based filename (SaveIds.Autosave embeds a ':',
    // not a valid filename character) and, on import, show up as "Unnamed save" in the list (Import
    // always lands as a named save, never as the autosave -- see FinishImportAsync). Synthesizing
    // "<module> - <date>" here fixes both at once: it becomes the exported filename's basis *and*
    // the DisplayName Import lands on this save with.
    private async Task Export(SaveEntry entry)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var json = await SaveStore.LoadAsync(entry.Id);
            if (json is null)
            {
                return;
            }

            var moduleTitle = _modulesById.GetValueOrDefault(entry.ModuleId)?.Title ?? entry.ModuleId;
            var displayName = entry.DisplayName ?? $"{moduleTitle} - {entry.LastPlayedUtc.ToLocalTime():yyyy-MM-dd}";

            using var sessionDoc = JsonDocument.Parse(json);
            var export = new SaveExport(entry.ModuleId, entry.ModuleVersion, displayName,
                entry.LastStateLabel, entry.LastPlayedUtc, entry.Language, sessionDoc.RootElement.Clone());
            var exportJson = JsonSerializer.Serialize(export);

            var fileName = $"{SanitizeFileName(displayName)}.mwsave";
            await SaveStore.ExportAsync(entry.Id, fileName, exportJson);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string SanitizeFileName(string name)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var cleaned = new string([.. name.Select(c => invalid.Contains(c) ? '_' : c)]).Trim();
        return cleaned.Length > 0 ? cleaned : "save";
    }

    private async Task OnUploadFileSelected(InputFileChangeEventArgs e)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            Logger.LogInformation("Save import: InputFile selected {FileName} ({Size} bytes)", e.File.Name, e.File.Size);
            _importError = null;
            try
            {
                using var stream = e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                await ProcessImportedBytesAsync(memory.ToArray());
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Save import: InputFile read/process failed");
                // ex.Message is an internal exception message (English, per the "behind the scenes
                // strings stay in code" rule) even though it surfaces in this user-facing dialog.
                _importError = string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_ImportError_Generic, ex.Message);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // MAUI-only path (FilePicker.IsAvailable) — see INativeFilePicker's own remarks for why this
    // bypasses the InputFile element entirely on that head instead of sharing OnUploadFileSelected.
    private async Task OnNativePickerClicked()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            Logger.LogInformation("Save import: native picker opened");
            _importError = null;
            try
            {
                var bytes = await FilePicker.PickAsync(NativeFileKind.SaveFile);
                if (bytes is null)
                {
                    Logger.LogInformation("Save import: native picker cancelled");
                    return;
                }

                await ProcessImportedBytesAsync(bytes);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Save import: native picker read/process failed");
                _importError = string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_ImportError_Generic, ex.Message);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // Shared by both import paths above. Validates the uploaded file against whatever's installed
    // on this machine before ever touching the save store -- an unrecognized module id or a version
    // that doesn't match needs a confirmation, everything else imports straight away.
    private async Task ProcessImportedBytesAsync(byte[] bytes)
    {
        SaveExport? export;
        try
        {
            export = JsonSerializer.Deserialize<SaveExport>(bytes);
        }
        catch (JsonException)
        {
            _importError = AppStrings.ContinueList_ImportError_Invalid;
            return;
        }

        if (export is null || string.IsNullOrEmpty(export.ModuleId))
        {
            _importError = AppStrings.ContinueList_ImportError_Invalid;
            return;
        }

        var installed = _modulesById.GetValueOrDefault(export.ModuleId);
        if (installed is null)
        {
            _pendingImport = new PendingImport(export, AppStrings.ContinueList_ImportModuleMissingBody);
            return;
        }

        if (SemVer.Compare(export.ModuleVersion, installed.Version) != 0)
        {
            _pendingImport = new PendingImport(export, string.Format(AppStrings.EffectiveCulture,
                AppStrings.ContinueList_ImportVersionMismatchBody, installed.Title, installed.Version, export.ModuleVersion));
            return;
        }

        await FinishImportAsync(export);
    }

    private async Task ConfirmPendingImport()
    {
        if (_busy || _pendingImport is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var export = _pendingImport.Export;
            _pendingImport = null;
            await FinishImportAsync(export);
        }
        finally
        {
            _busy = false;
        }
    }

    // Always lands as a new named save, never an autosave -- SaveIds.Autosave is a deterministic,
    // continuously-overwritten id keyed by module, and an imported file silently becoming "the"
    // autosave for whatever's currently installed would be surprising and could clobber real
    // in-progress play. IsAutosave is therefore always false here regardless of what the exported
    // save originally was.
    private async Task FinishImportAsync(SaveExport export)
    {
        var entry = new SaveEntry(
            Id: SaveIds.NewNamedSave(),
            ModuleId: export.ModuleId,
            ModuleVersion: export.ModuleVersion,
            IsAutosave: false,
            DisplayName: export.DisplayName,
            LastStateLabel: export.LastStateLabel,
            LastPlayedUtc: export.LastPlayedUtc,
            Language: export.Language);

        await SaveStore.SaveAsync(entry, export.Session.GetRawText());
        Logger.LogInformation("Save import: imported {ModuleId} v{Version} as {Id}", export.ModuleId, export.ModuleVersion, entry.Id);
        await RefreshAsync();
    }

    private async Task Delete(SaveEntry? entry)
    {
        if (_busy || entry is null)
        {
            return;
        }

        _busy = true;
        try
        {
            _pendingDelete = null;
            await SaveStore.DeleteAsync(entry.Id);
            await RefreshAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}

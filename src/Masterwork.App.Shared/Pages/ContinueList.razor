@page "/continue"
@using System.Text.Json
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services
@using Masterwork.Engine.Session
@using Microsoft.Extensions.Logging
@inject ISaveStore SaveStore
@inject IModuleStore ModuleStore
@inject GameSessionState State
@inject IModuleStyleInjector StyleInjector
@inject NavigationManager Nav
@inject ILogger<GameSession> GameSessionLogger
@inject IJSRuntime JS

@{ AppSettingsApplier.ReassertCulture(); }
<PageTitle>@AppStrings.ContinueList_PageTitle</PageTitle>

<button type="button" class="mws-back-button" @onclick='() => Nav.NavigateTo("/")'>@AppStrings.Common_Back</button>

<div class="mws-continue-list">
    <h2>@AppStrings.ContinueList_Heading</h2>

    @if (_saves.Count == 0)
    {
        <p>@AppStrings.ContinueList_Empty</p>
    }
    else
    {
        @foreach (var save in _saves.OrderByDescending(s => s.LastPlayedUtc))
        {
            var installed = _modulesById.GetValueOrDefault(save.ModuleId);
            var moduleTitle = installed?.Title ?? save.ModuleId;
            var versionWarning = VersionWarning(save, installed);

            <div class="mws-save-row">
                <div class="mws-save-info">
                    <strong>@(save.DisplayName ?? (save.IsAutosave ? AppStrings.Common_Autosave : AppStrings.ContinueList_UnnamedSave))</strong>
                    <span>@moduleTitle</span>
                    <span>@(save.LastStateLabel ?? "")</span>
                    <span class="mws-save-timestamp">@save.LastPlayedUtc.ToLocalTime().ToString("g", AppStrings.EffectiveCulture)</span>
                    @if (save.Language is not null)
                    {
                        <span class="mws-save-language">@save.Language</span>
                    }
                    @if (installed is null)
                    {
                        <span class="mws-version-warning">⚠ @AppStrings.ContinueList_ModuleMissing</span>
                    }
                    else if (versionWarning is not null)
                    {
                        <span class="mws-version-warning">⚠ @versionWarning</span>
                    }
                </div>
                <div class="mws-save-actions">
                    <button type="button" disabled="@(installed is null)"
                            title="@(installed is null ? AppStrings.ContinueList_ModuleMissingTitle : null)"
                            @onclick="() => Resume(save)">@AppStrings.Common_Resume</button>
                    <button type="button" @onclick="() => Export(save)">@AppStrings.Common_Export</button>
                    <button type="button" @onclick="() => Delete(save)">@AppStrings.Common_Delete</button>
                </div>
            </div>
        }
    }
</div>

@if (_pendingResume is not null)
{
    var moduleTitle = _modulesById.GetValueOrDefault(_pendingResume.ModuleId)?.Title ?? _pendingResume.ModuleId;

    <div class="mws-dialog-overlay">
        <div class="mws-dialog">
            <h3>@AppStrings.ContinueList_ResumeConfirmTitle</h3>
            <p>@string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_ResumeConfirmBody, moduleTitle)</p>
            <div class="mws-dialog-actions">
                <button type="button" @onclick="() => ConfirmResume(_pendingResume)">@AppStrings.ContinueList_ResumeAnyway</button>
                <button type="button" @onclick="() => _pendingResume = null">@AppStrings.Common_Cancel</button>
            </div>
        </div>
    </div>
}

@if (_resumeError is not null)
{
    <div class="mws-dialog-overlay">
        <div class="mws-dialog">
            <h3>@AppStrings.ContinueList_ResumeErrorTitle</h3>
            <p>@_resumeError</p>
            <div class="mws-dialog-actions">
                <button type="button" @onclick="() => _resumeError = null">@AppStrings.Common_Ok</button>
            </div>
        </div>
    </div>
}

<LoadingOverlay Show="@_loading" Message="@_loadingMessage" Done="@_loadingDone" Total="@_loadingTotal" />

@code {
    private List<SaveEntry> _saves = [];
    private Dictionary<string, InstalledModule> _modulesById = [];
    private SaveEntry? _pendingResume;
    private string? _resumeError;
    private bool _loading;
    private string _loadingMessage = "";
    private int? _loadingDone;
    private int? _loadingTotal;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _saves = [.. await SaveStore.ListAsync()];
        var modules = await ModuleStore.ListAsync();
        _modulesById = modules.ToDictionary(m => m.ModuleId);
    }

    // Warns in two directions: the save was made with a *newer* module version than what's
    // installed now (the module may have been downgraded, or the save came from elsewhere), or the
    // installed module has moved on by a major/minor version since the save was made (a patch-only
    // difference isn't flagged — that's not expected to break compatibility on its own).
    private static string? VersionWarning(SaveEntry save, InstalledModule? installed)
    {
        if (installed is null)
        {
            return null;
        }

        var comparison = SemVer.Compare(save.ModuleVersion, installed.Version);
        if (comparison > 0)
        {
            return string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_VersionWarning_Newer, save.ModuleVersion, installed.Version);
        }

        if (comparison < 0 && SemVer.MajorOrMinorDiffers(save.ModuleVersion, installed.Version))
        {
            return string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_VersionWarning_Moved, save.ModuleVersion, installed.Version);
        }

        return null;
    }

    // Only warns when resuming this save would actually clobber *newer* progress sitting in that
    // module's autosave — once play resumes, PersistAutosaveAsync (Play.razor) starts overwriting
    // the module's autosave with this save's progress. Nothing is lost by resuming a save that's
    // itself the autosave, or one that's already at least as recent as the autosave (a manual save
    // taken after the autosave supersedes it, same as Start New Game's own conflict check).
    private Task Resume(SaveEntry entry)
    {
        _resumeError = null;

        if (!_modulesById.ContainsKey(entry.ModuleId))
        {
            // The Resume button is disabled in this case (see the markup above) — this is just
            // defense in depth for a module uninstalled in the moment between page load and click.
            _resumeError = AppStrings.ContinueList_ResumeError_ModuleMissing;
            return Task.CompletedTask;
        }

        var autosave = _saves.FirstOrDefault(s => s.ModuleId == entry.ModuleId && s.IsAutosave);
        var wouldOverwriteNewerAutosave = !entry.IsAutosave && autosave is not null && autosave.LastPlayedUtc > entry.LastPlayedUtc;
        if (!wouldOverwriteNewerAutosave)
        {
            return ConfirmResume(entry);
        }

        _pendingResume = entry;
        return Task.CompletedTask;
    }

    private async Task ConfirmResume(SaveEntry entry)
    {
        _pendingResume = null;

        _loading = true;
        _loadingMessage = AppStrings.Common_Loading;
        _loadingDone = null;
        _loadingTotal = null;
        try
        {
            var json = await SaveStore.LoadAsync(entry.Id);
            if (json is null)
            {
                return;
            }

            var save = JsonSerializer.Deserialize<SessionSave>(json);
            if (save is null)
            {
                return;
            }

            var loaded = await ModuleStore.LoadAsync(entry.ModuleId, entry.Language);
            loaded = await PreloadAssetsAsync(loaded);
            var session = GameSession.Restore(loaded.Module, save, logger: GameSessionLogger);
            State.Start(entry.ModuleId, entry.ModuleVersion, entry.Language, loaded, session);
            await StyleInjector.ApplyAsync(loaded.StyleCss);
            Nav.NavigateTo("/play");
        }
        catch (InvalidOperationException ex)
        {
            // Defense in depth — Resume() already checks this ahead of time, but this covers the
            // module being uninstalled in the moment between opening this page and clicking Resume.
            // ex.Message is an internal exception message (English, per the "behind the scenes
            // strings stay in code" rule) even though it surfaces in this user-facing dialog.
            _resumeError = string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_ResumeError_Exception, ex.Message);
        }
        catch (JsonException ex)
        {
            // A save from an incompatible/older save-format revision (see SnapshotKind's remarks
            // for a concrete example) — surfaced the same way as any other resume failure rather
            // than crashing the app on data the player can't do anything about.
            _resumeError = string.Format(AppStrings.EffectiveCulture, AppStrings.ContinueList_ResumeError_Exception, ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    // Fetches every asset the module ships before navigating to /play, with progress — a passage's
    // images/fonts are already resident by the time it first renders instead of popping in one at a
    // time as IAssetResolver's own lazy, per-reference fetches would otherwise complete. Mirrors
    // StartNewGame.razor's own PreloadAssetsAsync.
    private async Task<LoadedModuleContent> PreloadAssetsAsync(LoadedModuleContent loaded)
    {
        // The previous session's preloaded object URLs (if any) are no longer reachable once this
        // new module's Assets replaces GameSessionState.Assets — revoke them now rather than leaking
        // their backing blobs for the rest of the tab's lifetime.
        if (State.Assets is PreloadedModuleAssetSource previous)
        {
            await previous.RevokeAllAsync(JS);
        }

        _loadingMessage = AppStrings.Common_PreparingAssets;
        _loadingDone = null;
        _loadingTotal = null;
        var progress = new Progress<(int Done, int Total)>(p => ReportProgress(p, AppStrings.Common_PreparingAssetsPercent));
        return await loaded.WithPreloadedAssetsAsync(progress);
    }

    // Fires from Progress<T>'s posted continuation, not the calling method's own await chain, so it
    // needs its own StateHasChanged rather than relying on the caller's next render.
    private void ReportProgress((int Done, int Total) p, string percentFormat)
    {
        _loadingDone = p.Done;
        _loadingTotal = p.Total;
        var percent = p.Total > 0 ? (int)(100.0 * p.Done / p.Total) : 0;
        _loadingMessage = string.Format(AppStrings.EffectiveCulture, percentFormat, percent);
        StateHasChanged();
    }

    private async Task Export(SaveEntry entry)
    {
        var json = await SaveStore.LoadAsync(entry.Id);
        if (json is null)
        {
            return;
        }

        var fileName = $"masterwork-save-{entry.Id}.json";
        await SaveStore.ExportAsync(entry.Id, fileName, json);
    }

    private async Task Delete(SaveEntry entry)
    {
        await SaveStore.DeleteAsync(entry.Id);
        await RefreshAsync();
    }
}

@page "/"
@using System.Text.Json
@using Masterwork.App.Shared.Services
@using Masterwork.Engine.Session
@inject IModuleLoader ModuleLoader
@inject ISaveStore SaveStore
@inject GameSessionState State
@inject NavigationManager Nav

<PageTitle>Masterwork</PageTitle>

<h1>Masterwork</h1>
<p>A community companion app for <em>My Father's Work</em>.</p>

<p>
    Real module loading (extracted scenario directories, <code>.mwm</code> packages) is still being
    built out. For now, start the small hand-authored sample scenario below to exercise the
    rendering pipeline end-to-end.
</p>

<button type="button" @onclick="StartSampleSession">Start sample scenario</button>

<h2>Continue</h2>
@for (var i = 0; i < SlotCount; i++)
{
    var slot = i;
    <button type="button" disabled="@(!_hasSave[slot])" @onclick="() => Continue(slot)">Continue slot @(slot + 1)</button>
}

@code {
    private const int SlotCount = 3;
    private readonly bool[] _hasSave = new bool[SlotCount];

    protected override async Task OnInitializedAsync()
    {
        // ISaveStore may use IJSRuntime (browser localStorage), which throws if called during the
        // server-side static prerender pass. This component gets re-initialized once the
        // WebAssembly client takes over, when RendererInfo.IsInteractive is true and the check below
        // stops skipping.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        for (var i = 0; i < SlotCount; i++)
        {
            _hasSave[i] = await SaveStore.HasSaveAsync(i);
        }
    }

    private void StartSampleSession()
    {
        var module = ModuleLoader.LoadFromSources(SampleModule.PassageYamls, SampleModule.VariablesYaml);
        var session = new GameSession(module, masterSeed: Random.Shared.NextInt64());
        State.Start(module, session);
        Nav.NavigateTo("/play");
    }

    private async Task Continue(int slot)
    {
        var json = await SaveStore.LoadAsync(slot);
        if (json is null)
        {
            return;
        }

        var save = JsonSerializer.Deserialize<SessionSave>(json);
        if (save is null)
        {
            return;
        }

        // Real module identification (which module a save belongs to) is deferred along with Q10 —
        // for now the only loadable module is the embedded SampleModule, so it's safe to
        // reconstruct it directly rather than looking anything up.
        var module = ModuleLoader.LoadFromSources(SampleModule.PassageYamls, SampleModule.VariablesYaml);
        var session = GameSession.Restore(module, save);
        State.Start(module, session);
        Nav.NavigateTo("/play");
    }
}

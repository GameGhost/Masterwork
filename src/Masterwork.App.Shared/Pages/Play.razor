@page "/play"
@using Masterwork.App.Shared.Chrome
@inject GameSessionState State

<PageTitle>Masterwork</PageTitle>

@if (State.Session is null)
{
    <p>No active session. <a href="/">Start a new game</a>.</p>
}
else
{
    <TimelineScrubber Session="State.Session" OnStateChanged="Refresh" />

    <PassageView Result="State.Session.CurrentRender" Session="State.Session" IsRewound="State.Session.IsRewound" OnStateChanged="Refresh" />

    <SaveMenu State="State" OnStateChanged="Refresh" />
}

@code {
    private void Refresh() => StateHasChanged();
}

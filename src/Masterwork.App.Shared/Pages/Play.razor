@page "/play"
@using System.Text.Json
@using Masterwork.App.Shared.Chrome
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services
@inject GameSessionState State
@inject IAudioPlayer AudioPlayer
@inject IModuleStyleInjector StyleInjector
@inject ISaveStore SaveStore
@inject NavigationManager Nav

@{ AppSettingsApplier.ReassertCulture(); }
<PageTitle>Masterwork</PageTitle>

@if (State.Session is null)
{
    <p>@AppStrings.Play_NoSessionMessage <a href="/">@AppStrings.Play_ReturnToMainMenuLink</a>.</p>
}
else
{
    <div class="mws-play-chrome">
        @if (State.Session.IsRewound)
        {
            <TimelineScrubber Session="State.Session" OnStateChanged="Refresh" />
        }
        else
        {
            <button type="button" class="mws-back-button" disabled="@(!State.Session.CanStepBack)" @onclick="StepBack">@AppStrings.Common_Back</button>
        }
        <button type="button" class="mws-options-button" @onclick="() => _showOptions = true">⚙</button>
    </div>

    <ErrorBoundary @ref="_errorBoundary">
        <ChildContent>
            <PassageView Result="State.Session.CurrentRender" Session="State.Session" IsRewound="State.Session.IsRewound"
                         OnStateChanged="Refresh" OnInputChanged="RefreshUiOnly" />
        </ChildContent>
        <ErrorContent Context="ex">
            @if (_showQuitFromNavError)
            {
                <OptionsDialog DialogContext="OptionsDialogContext.InGame" StartAtQuit="true"
                               OnClose="() => _showQuitFromNavError = false"
                               OnSaveAndQuit="SaveAndQuit" OnAbandonGame="AbandonGame" DefaultSaveName="@DefaultSaveName()" />
            }
            else
            {
                <div class="mws-dialog-overlay">
                    <div class="mws-dialog mws-nav-error-dialog">
                        <h3>@AppStrings.Play_NavErrorTitle</h3>
                        <p>@AppStrings.Play_NavErrorBody</p>
                        <p class="mws-nav-error-detail">@ex.Message</p>
                        <div class="mws-dialog-actions">
                            <button type="button" @onclick="RecoverFromNavError">@AppStrings.Play_NavErrorReturnButton</button>
                            <button type="button" class="mws-quit-button" @onclick="() => _showQuitFromNavError = true">@AppStrings.OptionsDialog_Quit</button>
                        </div>
                    </div>
                </div>
            }
        </ErrorContent>
    </ErrorBoundary>

    @if (_showOptions)
    {
        <OptionsDialog DialogContext="OptionsDialogContext.InGame" OnClose="() => _showOptions = false"
                       OnSaveAndQuit="SaveAndQuit" OnAbandonGame="AbandonGame" DefaultSaveName="@DefaultSaveName()" />
    }
}

@code {
    private bool _showOptions;
    private ErrorBoundary? _errorBoundary;
    private bool _showQuitFromNavError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && State.Session is not null)
        {
            await AudioPlayer.SetAmbientOnlyAsync(State.Session.IsRewound);
            await HandleGameOverOrAutosaveAsync();
        }
    }

    private async Task Refresh()
    {
        StateHasChanged();
        if (State.Session is not null)
        {
            await AudioPlayer.SetAmbientOnlyAsync(State.Session.IsRewound);
            await HandleGameOverOrAutosaveAsync();
        }
    }

    // For input drafts and other purely-local view-state toggles (e.g. cancelling a popup) that
    // haven't actually committed anything to the session — a keystroke isn't "progress" worth an
    // ambient-audio sync or a full autosave (JSON-serializing the whole timeline plus several
    // localStorage JS-interop round trips), and doing that work on every keystroke is what makes
    // typing inside a popup feel like it lags several seconds behind, especially on single-threaded
    // WASM. Sibling components (e.g. a link's disabled state, which depends on
    // GameSession.AreCurrentInputsValid) still need to see the new draft, so this still re-renders
    // the whole subtree — it just skips the two genuinely expensive, unnecessary side effects.
    private void RefreshUiOnly() => StateHasChanged();

    private async Task StepBack()
    {
        if (State.Session is not { CanStepBack: true })
        {
            return;
        }

        State.Session.StepBack();
        await Refresh();
    }

    // Recovery for the ErrorBoundary wrapping PassageView — most commonly a link/popup/goto
    // targeting a passage_id that doesn't exist (GameSession.PassageNotFoundException), thrown
    // mid-FollowLinkAsync/ClosePopupAsync after input drafts and onclick/onclose side effects
    // already committed to the live store but before any new timeline entry landed. "Return to
    // this passage" rolls the live store back to the last good snapshot (GameSession's own
    // RecoverFromFailedNavigation) so play can continue from where it actually still is, then
    // clears the tripped ErrorBoundary so PassageView renders again.
    private void RecoverFromNavError()
    {
        State.Session?.RecoverFromFailedNavigation();
        _showQuitFromNavError = false;
        _errorBoundary?.Recover();
    }

    // A module signals "this playthrough is complete" by resolving a link/popup/goto target to the
    // "app::gameover" sentinel (see GameSession.IsGameOverRequested's remarks) — not by any
    // passage-level flag, and not something the engine acts on itself. Checked ahead of the ordinary
    // autosave persistence at every point that already calls it (first render, and after every
    // state-changing action), since IsGameOverRequested can only become true as a result of one of
    // those actions. A completed playthrough has nothing left to resume, so this deletes the
    // autosave and returns to the main menu instead of upserting it.
    private async Task HandleGameOverOrAutosaveAsync()
    {
        if (State.Session is not { IsGameOverRequested: true })
        {
            await PersistAutosaveAsync();
            return;
        }

        if (State.ModuleId is not null)
        {
            // TODO: preserve this playthrough's "memory" into the logbook (Town Records — see
            // docs/mws-format-latest.md's own TBD note; not yet designed).
            await SaveStore.DeleteAsync(SaveIds.Autosave(State.ModuleId));
        }

        await StyleInjector.ApplyAsync(null);
        State.Clear();
        Nav.NavigateTo("/");
    }

    // Continuously updates the module's autosave while playing live (not while just reviewing
    // history via the timeline scrubber) — see masterwork-plan-rev13.md Section 13's save model.
    private async Task PersistAutosaveAsync()
    {
        if (State.Session is null || State.ModuleId is null || State.Session.IsRewound)
        {
            return;
        }

        var entry = new SaveEntry(
            Id: SaveIds.Autosave(State.ModuleId),
            ModuleId: State.ModuleId,
            ModuleVersion: State.ModuleVersion ?? "",
            IsAutosave: true,
            DisplayName: null,
            LastStateLabel: State.Session.Current.DisplayLabel ?? State.Session.CurrentRender.PassageId,
            LastPlayedUtc: DateTimeOffset.UtcNow,
            Language: State.Language);
        var json = JsonSerializer.Serialize(State.Session.Serialize());
        await SaveStore.SaveAsync(entry, json);
    }

    private string DefaultSaveName()
    {
        var townName = State.Session?.Current.Variables.TryGetValue("townname", out var v) == true ? v.AsString() : "Session";
        return $"{townName} — {DateTime.Now.ToString("yyyy-MM-dd", AppStrings.EffectiveCulture)}";
    }

    private async Task SaveAndQuit(string name)
    {
        if (State.Session is null || State.ModuleId is null)
        {
            return;
        }

        var entry = new SaveEntry(
            Id: SaveIds.NewNamedSave(),
            ModuleId: State.ModuleId,
            ModuleVersion: State.ModuleVersion ?? "",
            IsAutosave: false,
            DisplayName: name,
            LastStateLabel: State.Session.Current.DisplayLabel ?? State.Session.CurrentRender.PassageId,
            LastPlayedUtc: DateTimeOffset.UtcNow,
            Language: State.Language);
        var json = JsonSerializer.Serialize(State.Session.Serialize());
        await SaveStore.SaveAsync(entry, json);

        // The autosave is deliberately left in place — Start New Game and Continue now both consider
        // whichever save (autosave or named) is actually most recent, rather than always assuming the
        // autosave wins, so leaving it here no longer risks silently shadowing this named save.
        await StyleInjector.ApplyAsync(null);
        State.Clear();
        Nav.NavigateTo("/continue");
    }

    private async Task AbandonGame()
    {
        // The autosave is deliberately left in place — abandoning just means "stop playing right
        // now," not "erase this progress." The player can still find it via Continue (or get
        // prompted to resume it from Start New Game) later if they change their mind.
        await StyleInjector.ApplyAsync(null);
        State.Clear();
        Nav.NavigateTo("/");
    }
}

@page "/"
@using Masterwork.App.Shared.Chrome
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services

@inject NavigationManager Nav
@inject IMainMenuTheme? Theme

@{ AppSettingsApplier.ReassertCulture(); }
<PageTitle>Masterwork - My Father's Work</PageTitle>

<div class="mws-main-menu">
    @* The background scene's whole structure (not just its images) is theme-provided — see
       IMainMenuTheme's own remarks for why (a structurally different future theme might not have a
       "manor"/"mountain" concept at all). Falls back to nothing rather than crashing if no theme is
       registered (a "bare" build) — just the plain background color from theme.css/app.css.
       aria-hidden since it's pure decoration, not content. *@
    <div class="mws-main-menu-scene" aria-hidden="true">
        @if (Theme is not null)
        {
            <DynamicComponent Type="Theme.SceneComponentType" />
        }
    </div>
    <div class="mws-main-menu-border" aria-hidden="true"></div>

    <h1 class="mws-visually-hidden">Masterwork - My Father's Work</h1>

    <ChromeButton class="mws-main-menu-help" OnClick='() => Nav.NavigateTo("/help")'>
        <span class="mws-visually-hidden">@AppStrings.MainMenu_Help</span>
    </ChromeButton>

    <div class="mws-main-menu-content">
        <div class="mws-main-menu-logo" role="img" aria-label="My Father's Work"></div>
        <p class="mws-main-menu-tagline">@((MarkupString)AppStrings.MainMenu_Tagline)</p>

        <nav class="mws-main-menu-buttons">
            <ChromeButton OnClick='() => Nav.NavigateTo("/new-game")'>@AppStrings.MainMenu_StartNewGame</ChromeButton>
            <ChromeButton OnClick='() => Nav.NavigateTo("/continue")'>@AppStrings.MainMenu_Continue</ChromeButton>
            <ChromeButton OnClick="() => _showOptions = true">@AppStrings.MainMenu_Options</ChromeButton>
            <ChromeButton disabled title="@AppStrings.Common_ComingSoon" OnClick='() => Nav.NavigateTo("/achievements")'>@AppStrings.MainMenu_Achievements</ChromeButton>
        </nav>
    </div>
</div>

@if (_showOptions)
{
    <OptionsDialog DialogContext="OptionsDialogContext.MainMenu"
                   OnClose="() => _showOptions = false"
                   OnManageModules='() => Nav.NavigateTo("/modules/manage")' />
}

@code {
    private bool _showOptions;
}

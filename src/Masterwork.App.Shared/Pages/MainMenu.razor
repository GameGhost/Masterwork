@page "/"
@using Masterwork.App.Shared.Chrome
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services

@inject ISaveStore SaveStore
@inject NavigationManager Nav

@{ AppSettingsApplier.ReassertCulture(); }
<PageTitle>Masterwork - My Father's Work</PageTitle>

<div class="mws-main-menu">
    <h1>Masterwork</h1>
    <p>@((MarkupString)AppStrings.MainMenu_Tagline)</p>

    <nav class="mws-main-menu-buttons">
        <button type="button" @onclick='() => Nav.NavigateTo("/help")'>@AppStrings.MainMenu_Help</button>
        <button type="button" @onclick='() => Nav.NavigateTo("/achievements")'>@AppStrings.MainMenu_Achievements</button>
        <button type="button" @onclick="() => _showOptions = true">@AppStrings.MainMenu_Options</button>
        <button type="button" disabled="@(!_hasAnySave)" @onclick='() => Nav.NavigateTo("/continue")'>@AppStrings.MainMenu_Continue</button>
        <button type="button" @onclick='() => Nav.NavigateTo("/new-game")'>@AppStrings.MainMenu_StartNewGame</button>
    </nav>
</div>

@if (_showOptions)
{
    <OptionsDialog DialogContext="OptionsDialogContext.MainMenu"
                   OnClose="() => _showOptions = false"
                   OnManageModules='() => Nav.NavigateTo("/modules/manage")' />
}

@code {
    private bool _hasAnySave;
    private bool _showOptions;

    protected override async Task OnInitializedAsync()
    {
        // ISaveStore may use IJSRuntime (browser localStorage), which throws if called during the
        // server-side static prerender pass. This component gets re-initialized once the
        // WebAssembly client takes over, when RendererInfo.IsInteractive is true and the check below
        // stops skipping.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var saves = await SaveStore.ListAsync();
        _hasAnySave = saves.Count > 0;
    }
}

@page "/help"
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services
@inject NavigationManager Nav

@{ AppSettingsApplier.ReassertCulture(); }
<PageTitle>@AppStrings.Help_PageTitle</PageTitle>

<button type="button" class="mws-back-button" @onclick='() => Nav.NavigateTo("/")'>@AppStrings.Common_Back</button>

<div class="mws-help">
    <nav class="mws-help-topics">
        @foreach (var topic in Topics)
        {
            <button type="button" class="@(topic == _selected ? "selected" : "")" @onclick="() => _selected = topic">@TopicLabel(topic)</button>
        }
    </nav>
    <div class="mws-help-content">
        @switch (_selected)
        {
            case HelpTopic.HowToUse:
                <h3>@AppStrings.Help_HowToUse_Title</h3>
                <p>@((MarkupString)AppStrings.Help_HowToUse_Body)</p>
                break;
            case HelpTopic.TimelineAndRewind:
                <h3>@AppStrings.Help_TimelineRewind_Title</h3>
                <p>@AppStrings.Help_TimelineRewind_Body</p>
                break;
            case HelpTopic.Saves:
                <h3>@AppStrings.Help_Saves_Title</h3>
                <p>@AppStrings.Help_Saves_Body</p>
                break;
        }
    </div>
</div>

@code {
    private enum HelpTopic { HowToUse, TimelineAndRewind, Saves }

    private static readonly HelpTopic[] Topics = [HelpTopic.HowToUse, HelpTopic.TimelineAndRewind, HelpTopic.Saves];
    private HelpTopic _selected = Topics[0];

    // Stable internal keys (HelpTopic) drive selection/dispatch; only the displayed label is
    // localized, so switching the UI language can never change which topic is "selected".
    private static string TopicLabel(HelpTopic topic) => topic switch
    {
        HelpTopic.HowToUse => AppStrings.Help_Topic_HowToUse,
        HelpTopic.TimelineAndRewind => AppStrings.Help_Topic_TimelineAndRewind,
        HelpTopic.Saves => AppStrings.Help_Topic_Saves,
        _ => throw new ArgumentOutOfRangeException(nameof(topic)),
    };
}

@page "/new-game"
@using System.Text.Json
@using Masterwork.App.Shared.Services
@using Masterwork.Engine.Session
@inject IModuleStore ModuleStore
@inject ISaveStore SaveStore
@inject GameSessionState State
@inject NavigationManager Nav

<PageTitle>Masterwork — Start New Game</PageTitle>

<button type="button" class="mws-back-button" @onclick='() => Nav.NavigateTo("/")'>◀ Back</button>

<div class="mws-start-new-game">
    <div class="mws-module-toolbar">
        <button type="button" disabled title="Coming soon — needs a hosted module registry (Phase 6)">Download Modules</button>
        <label class="mws-upload-button">
            Upload Module
            <InputFile OnChange="OnUploadFileSelected" accept=".mwm" />
        </label>
    </div>
    @if (_uploadError is not null)
    {
        <p class="mws-version-warning">@_uploadError</p>
    }

    <div class="mws-module-carousel">
        @foreach (var module in _modules)
        {
            <div class="mws-module-tile @(module.ModuleId == _selectedId ? "selected" : "")" @onclick="() => _selectedId = module.ModuleId">
                @if (module.IsBuiltIn)
                {
                    <span class="mws-badge">Built-in</span>
                }
                <strong>@module.Title</strong>
            </div>
        }
    </div>

    @if (_selected is not null)
    {
        <div class="mws-module-detail">
            <p>@_selected.Description</p>
            <button type="button" @onclick="() => Play(_selected)">Play</button>
        </div>
    }

    @if (_conflictModule is not null)
    {
        <div class="mws-dialog-overlay">
            <div class="mws-dialog">
                <h3>Resume in-progress session?</h3>
                <p>@_conflictModule.Title already has an autosave in progress.</p>
                <div class="mws-dialog-actions">
                    <button type="button" @onclick="ResumeConflicting">Resume</button>
                    <button type="button" @onclick="DiscardAndStartFresh">Discard previous session</button>
                    <button type="button" @onclick="() => _conflictModule = null">Cancel</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<InstalledModule> _modules = [];
    private string? _selectedId;
    private InstalledModule? _selected => _modules.FirstOrDefault(m => m.ModuleId == _selectedId);
    private InstalledModule? _conflictModule;
    private string? _uploadError;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _modules = await ModuleStore.ListAsync();
        _selectedId = _modules.FirstOrDefault()?.ModuleId;
    }

    private async Task Play(InstalledModule? module)
    {
        if (module is null)
        {
            return;
        }

        var autosaveId = SaveIds.Autosave(module.ModuleId);
        var saves = await SaveStore.ListAsync();
        if (saves.Any(s => s.Id == autosaveId))
        {
            _conflictModule = module;
            return;
        }

        await StartFreshAsync(module);
    }

    private async Task ResumeConflicting()
    {
        if (_conflictModule is null)
        {
            return;
        }

        var module = _conflictModule;
        _conflictModule = null;

        var json = await SaveStore.LoadAsync(SaveIds.Autosave(module.ModuleId));
        if (json is null)
        {
            await StartFreshAsync(module);
            return;
        }

        var save = JsonSerializer.Deserialize<SessionSave>(json);
        if (save is null)
        {
            await StartFreshAsync(module);
            return;
        }

        var loaded = await ModuleStore.LoadAsync(module.ModuleId);
        var session = GameSession.Restore(loaded, save);
        State.Start(module.ModuleId, module.Version, loaded, session);
        Nav.NavigateTo("/play");
    }

    private async Task DiscardAndStartFresh()
    {
        if (_conflictModule is null)
        {
            return;
        }

        var module = _conflictModule;
        _conflictModule = null;
        await SaveStore.DeleteAsync(SaveIds.Autosave(module.ModuleId));
        await StartFreshAsync(module);
    }

    private async Task StartFreshAsync(InstalledModule module)
    {
        var loaded = await ModuleStore.LoadAsync(module.ModuleId);
        var session = new GameSession(loaded, masterSeed: Random.Shared.NextInt64());
        State.Start(module.ModuleId, module.Version, loaded, session);
        Nav.NavigateTo("/play");
    }

    private async Task OnUploadFileSelected(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);

            var installed = await ModuleStore.InstallAsync(memory.ToArray());
            _modules = await ModuleStore.ListAsync();
            _selectedId = installed.ModuleId;
        }
        catch (Exception ex)
        {
            _uploadError = $"Couldn't install that module: {ex.Message}";
        }
    }
}

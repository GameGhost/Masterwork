@page "/new-game"
@using System.Security.Cryptography
@using System.Text.Json
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services
@using Masterwork.Engine.Session
@using Masterwork.ModuleFormat
@using Microsoft.Extensions.Logging
@inject IModuleStore ModuleStore
@inject ISaveStore SaveStore
@inject IAppSettingsStore SettingsStore
@inject GameSessionState State
@inject IModuleStyleInjector StyleInjector
@inject NavigationManager Nav
@inject ILogger<GameSession> GameSessionLogger

@{ AppSettingsApplier.ReassertCulture(); }
<PageTitle>@AppStrings.StartNewGame_PageTitle</PageTitle>

<button type="button" class="mws-back-button" @onclick='() => Nav.NavigateTo("/")'>@AppStrings.Common_Back</button>

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        <div class="mws-start-new-game">
            <div class="mws-module-toolbar">
                <button type="button" disabled title="@AppStrings.StartNewGame_DownloadModulesHint">@AppStrings.StartNewGame_DownloadModules</button>
                <label for="mws-upload-input" class="mws-upload-button">@AppStrings.StartNewGame_UploadModule</label>
                <InputFile id="mws-upload-input" class="mws-visually-hidden" OnChange="OnUploadFileSelected"
                           accept=".mwm,application/zip,application/x-zip-compressed,application/octet-stream" />
            </div>
            @if (_uploadError is not null)
            {
                <p class="mws-version-warning">@_uploadError</p>
            }

            <div class="mws-module-carousel">
                @foreach (var module in _modules)
                {
                    <div class="mws-module-tile @(module.ModuleId == _selectedId ? "selected" : "")" @onclick="() => SelectModule(module.ModuleId)">
                        @if (module.IsBuiltIn)
                        {
                            <span class="mws-badge">@AppStrings.Common_BuiltInBadge</span>
                        }
                        <strong>@module.Title</strong>
                        <span class="mws-tile-version">v@(module.Version)</span>
                    </div>
                }
            </div>

            @if (_selected is null)
            {
                <p class="mws-empty-state">@AppStrings.StartNewGame_SelectPrompt</p>
            }
            else
            {
                <div class="mws-module-detail">
                    <p>@_selected.Description</p>
                    <button type="button" @onclick="() => Play(_selected)">@AppStrings.StartNewGame_Play</button>
                    <select class="mws-module-language" value="@_selectedLanguage" disabled="@(_selected.AvailableLanguages.Count <= 1)" @onchange="OnLanguageChanged">
                        @foreach (var lang in _selected.AvailableLanguages)
                        {
                            <option value="@lang">@lang</option>
                        }
                    </select>
                </div>
            }

            @if (_conflictModule is not null)
            {
                <div class="mws-dialog-overlay">
                    <div class="mws-dialog">
                        <h3>@AppStrings.StartNewGame_ConflictTitle</h3>
                        <p>@string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_ConflictBody, _conflictModule.Title)</p>
                        @if (ConflictAutosaveSummary() is { } summary)
                        {
                            <p class="mws-save-timestamp">@summary</p>
                        }
                        <div class="mws-dialog-actions">
                            <button type="button" @onclick="ResumeConflicting">@AppStrings.Common_Resume</button>
                            <button type="button" @onclick="DiscardAndStartFresh">@AppStrings.StartNewGame_DiscardPrevious</button>
                            <button type="button" @onclick="() => { _conflictModule = null; _conflictAutosave = null; }">@AppStrings.Common_Cancel</button>
                        </div>
                    </div>
                </div>
            }

            @if (_pendingUpload is not null)
            {
                <div class="mws-dialog-overlay">
                    <div class="mws-dialog">
                        <h3>@_pendingUpload.Title</h3>
                        <p>@_pendingUpload.Message</p>
                        <div class="mws-dialog-actions">
                            <button type="button" @onclick="ConfirmPendingUpload">@_pendingUpload.ConfirmLabel</button>
                            <button type="button" @onclick="() => _pendingUpload = null">@AppStrings.Common_Cancel</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <ErrorContent>
        <div class="mws-start-new-game">
            <p class="mws-version-warning">@AppStrings.StartNewGame_ErrorFallback</p>
            <button type="button" @onclick="Recover">@AppStrings.Common_TryAgain</button>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private sealed record PendingUpload(byte[] Bytes, string Title, string Message, string ConfirmLabel);

    private IReadOnlyList<InstalledModule> _modules = [];
    private string? _selectedId;
    private InstalledModule? _selected => _modules.FirstOrDefault(m => m.ModuleId == _selectedId);
    private string? _selectedLanguage;
    private InstalledModule? _conflictModule;
    private SaveEntry? _conflictAutosave;
    private string? _uploadError;
    private PendingUpload? _pendingUpload;
    private ErrorBoundary? _errorBoundary;
    private AppSettings _appSettings = AppSettings.Default;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _modules = await ModuleStore.ListAsync();
        _appSettings = await SettingsStore.LoadAsync();
        // Deliberately starts with nothing selected — the carousel is meant to be browsed, not
        // auto-committed to whatever happened to load first.
    }

    private void Recover()
    {
        _errorBoundary?.Recover();
    }

    // Resets the language choice every time the selected module changes: the preferred module
    // language (Options) if that module actually has it, else the module's own default, else
    // whatever's there — never carries a previous module's language selection over by accident.
    private void SelectModule(string moduleId)
    {
        _selectedId = moduleId;
        _selectedLanguage = _selected is { } module ? DefaultLanguageFor(module, _appSettings.PreferredModuleLanguage) : null;
    }

    private static string DefaultLanguageFor(InstalledModule module, string? preferred)
    {
        if (preferred is not null && module.AvailableLanguages.Contains(preferred))
        {
            return preferred;
        }

        return module.AvailableLanguages.Contains(ModuleLocales.Default)
            ? ModuleLocales.Default
            : module.AvailableLanguages[0];
    }

    private void OnLanguageChanged(ChangeEventArgs e) => _selectedLanguage = e.Value?.ToString();

    private string? ConflictAutosaveSummary()
    {
        if (_conflictAutosave is null)
        {
            return null;
        }

        var parts = new[] { _conflictAutosave.LastStateLabel, _conflictAutosave.LastPlayedUtc.ToLocalTime().ToString("g", AppStrings.EffectiveCulture), _conflictAutosave.Language }
            .Where(s => !string.IsNullOrEmpty(s));
        return string.Join(" · ", parts);
    }

    private async Task Play(InstalledModule? module)
    {
        if (module is null)
        {
            return;
        }

        var autosaveId = SaveIds.Autosave(module.ModuleId);
        var saves = await SaveStore.ListAsync();
        var autosave = saves.FirstOrDefault(s => s.Id == autosaveId);
        if (autosave is not null)
        {
            _conflictModule = module;
            _conflictAutosave = autosave;
            return;
        }

        await StartFreshAsync(module, _selectedLanguage);
    }

    private async Task ResumeConflicting()
    {
        if (_conflictModule is null)
        {
            return;
        }

        var module = _conflictModule;
        var autosaveLanguage = _conflictAutosave?.Language;
        _conflictModule = null;
        _conflictAutosave = null;

        var json = await SaveStore.LoadAsync(SaveIds.Autosave(module.ModuleId));
        if (json is null)
        {
            await StartFreshAsync(module, _selectedLanguage);
            return;
        }

        SessionSave? save;
        try
        {
            save = JsonSerializer.Deserialize<SessionSave>(json);
        }
        catch (JsonException)
        {
            // An autosave from an incompatible/older save-format revision — treat exactly like no
            // autosave existing rather than crashing the app on a stale format the player can't do
            // anything about (see SnapshotKind's remarks for a concrete example of how this happens).
            save = null;
        }

        if (save is null)
        {
            await StartFreshAsync(module, _selectedLanguage);
            return;
        }

        // Resuming always uses the save's own recorded language, not whatever's currently picked in
        // the dropdown — the save state is what decides, per the "preserved in the save state" rule.
        var loaded = await ModuleStore.LoadAsync(module.ModuleId, autosaveLanguage);
        var session = GameSession.Restore(loaded.Module, save, logger: GameSessionLogger);
        State.Start(module.ModuleId, module.Version, autosaveLanguage, loaded, session);
        await StyleInjector.ApplyAsync(loaded.StyleCss);
        Nav.NavigateTo("/play");
    }

    private async Task DiscardAndStartFresh()
    {
        if (_conflictModule is null)
        {
            return;
        }

        var module = _conflictModule;
        _conflictModule = null;
        _conflictAutosave = null;
        await SaveStore.DeleteAsync(SaveIds.Autosave(module.ModuleId));
        await StartFreshAsync(module, _selectedLanguage);
    }

    private async Task StartFreshAsync(InstalledModule module, string? language)
    {
        var loaded = await ModuleStore.LoadAsync(module.ModuleId, language);
        var session = new GameSession(loaded.Module, masterSeed: Random.Shared.NextInt64(), logger: GameSessionLogger);
        State.Start(module.ModuleId, module.Version, language, loaded, session);
        await StyleInjector.ApplyAsync(loaded.StyleCss);
        Nav.NavigateTo("/play");
    }

    private async Task OnUploadFileSelected(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var bytes = memory.ToArray();

            var contents = ModulePackage.ReadFromBytes(bytes);
            if (contents.ManifestYaml is null)
            {
                _uploadError = AppStrings.StartNewGame_UploadError_NoManifest;
                return;
            }

            var manifest = new ManifestParser().Parse(contents.ManifestYaml);
            if (manifest.Id == BuiltInModules.DemoModuleId)
            {
                _uploadError = AppStrings.StartNewGame_UploadError_ReservedId;
                return;
            }

            var existing = _modules.FirstOrDefault(m => m.ModuleId == manifest.Id);
            if (existing is null)
            {
                await InstallBytesAsync(bytes);
                return;
            }

            await PrepareConflictPromptAsync(bytes, manifest, existing);
        }
        catch (Exception ex)
        {
            // ex.Message is an internal exception message (English, per the "behind the scenes
            // strings stay in code" rule) even though it surfaces in this user-facing dialog.
            _uploadError = string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_UploadError_Generic, ex.Message);
        }
    }

    // Compares the uploaded manifest's version against what's already installed under the same id
    // and prepares an appropriately-worded confirm prompt — same content is a no-op-ish notice, an
    // upgrade/downgrade gets a warning scaled to the risk, mentioning existing saves if there are any
    // (masterwork-plan-rev14's upload-conflict design, added after manual testing surfaced the need).
    private async Task PrepareConflictPromptAsync(byte[] bytes, ModuleManifest manifest, InstalledModule existing)
    {
        var saveCount = (await SaveStore.ListAsync()).Count(s => s.ModuleId == manifest.Id);
        var saveNote = saveCount switch
        {
            0 => "",
            1 => AppStrings.StartNewGame_SaveNote_One,
            _ => string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_SaveNote_Many, saveCount),
        };

        var comparison = SemVer.Compare(manifest.Version, existing.Version);

        if (comparison == 0)
        {
            var existingBytes = await ModuleStore.GetPackageBytesAsync(manifest.Id);
            var identical = existingBytes is not null && ComputeHash(existingBytes).SequenceEqual(ComputeHash(bytes));

            _pendingUpload = identical
                ? new PendingUpload(bytes, AppStrings.StartNewGame_AlreadyInstalledTitle,
                    string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_AlreadyInstalledBody, manifest.Title, manifest.Version),
                    AppStrings.StartNewGame_ReinstallAnyway)
                : new PendingUpload(bytes, AppStrings.StartNewGame_SameVersionDiffContentTitle,
                    string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_SameVersionDiffContentBody, manifest.Title, manifest.Version, saveNote),
                    AppStrings.StartNewGame_ReplaceAnyway);
            return;
        }

        if (comparison > 0)
        {
            _pendingUpload = new PendingUpload(bytes, AppStrings.StartNewGame_UpgradeTitle,
                string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_UpgradeBody, manifest.Title, existing.Version, manifest.Version, saveNote),
                AppStrings.StartNewGame_Upgrade);
            return;
        }

        _pendingUpload = new PendingUpload(bytes, AppStrings.StartNewGame_DowngradeTitle,
            string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_DowngradeBody, manifest.Title, existing.Version, manifest.Version, saveNote),
            AppStrings.StartNewGame_DowngradeAnyway);
    }

    private static byte[] ComputeHash(byte[] data) => SHA256.HashData(data);

    private async Task ConfirmPendingUpload()
    {
        if (_pendingUpload is null)
        {
            return;
        }

        var bytes = _pendingUpload.Bytes;
        _pendingUpload = null;
        await InstallBytesAsync(bytes);
    }

    private async Task InstallBytesAsync(byte[] bytes)
    {
        try
        {
            var installed = await ModuleStore.InstallAsync(bytes);
            _modules = await ModuleStore.ListAsync();
            SelectModule(installed.ModuleId);
        }
        catch (Exception ex)
        {
            // ex.Message is an internal exception message (English, per the "behind the scenes
            // strings stay in code" rule) even though it surfaces in this user-facing dialog.
            _uploadError = string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_UploadError_Generic, ex.Message);
        }
    }
}

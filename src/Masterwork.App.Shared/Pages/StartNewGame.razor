@page "/new-game"
@using System.Text.Json
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services
@using Masterwork.Engine.Session
@using Masterwork.ModuleFormat
@using Microsoft.Extensions.Logging
@inject IModuleStore ModuleStore
@inject ISaveStore SaveStore
@inject IAppSettingsStore SettingsStore
@inject GameSessionState State
@inject IModuleStyleInjector StyleInjector
@inject NavigationManager Nav
@inject ILogger<GameSession> GameSessionLogger
@inject ILogger<StartNewGame> Logger
@inject INativeFilePicker FilePicker
@inject IJSRuntime JS

@{ AppSettingsApplier.ReassertCulture(); }
<PageTitle>@AppStrings.StartNewGame_PageTitle</PageTitle>

@* Back button lives outside ErrorBoundary (always rendered, even if the content below crashes) --
   same reason it was already structured this way before this screen grew its own chrome. Wrapping
   both it and the ErrorBoundary in .mws-scenario-screen gives the whole page (crashed or not) the
   same leather background + main-menu border, rather than only the happy-path content getting it. *@
<div class="mws-scenario-screen">
    <div class="mws-scenario-border" aria-hidden="true"></div>
    <button type="button" class="mws-scenario-back-button" @onclick='() => Nav.NavigateTo("/")'>
        <span class="mws-visually-hidden">@AppStrings.Common_Back</span>
    </button>

    <ErrorBoundary @ref="_errorBoundary">
        <ChildContent>
            <div class="mws-start-new-game">
                <div class="mws-module-toolbar">
                    <button type="button" class="style-btn-brown" disabled title="@AppStrings.StartNewGame_DownloadModulesHint">@AppStrings.StartNewGame_DownloadModules</button>
                    @if (FilePicker.IsAvailable)
                    {
                        <button type="button" class="mws-upload-button style-btn-brown" disabled="@_busy" @onclick="OnNativePickerClicked">@AppStrings.StartNewGame_UploadModule</button>
                    }
                    else
                    {
                        <label for="mws-upload-input" class="mws-upload-button style-btn-brown">@AppStrings.StartNewGame_UploadModule</label>
                        <InputFile id="mws-upload-input" class="mws-visually-hidden" OnChange="OnUploadFileSelected"
                                   accept=".mwm,application/zip,application/x-zip-compressed,application/octet-stream" />
                    }
                </div>
                @if (_uploadError is not null)
                {
                    <p class="mws-version-warning">@_uploadError</p>
                }

                <div class="mws-scenario-content">
                    <div class="mws-module-carousel-row">
                        <button type="button" class="mws-carousel-nav-button mws-carousel-back" disabled="@(!CanStepCarousel(-1))"
                                @onclick="() => StepCarousel(-1)" aria-label="@AppStrings.TimelineScrubber_Back" title="@AppStrings.TimelineScrubber_Back"></button>
                        <div class="mws-module-carousel">
                            @for (var i = 0; i < _modules.Count; i++)
                            {
                                var module = _modules[i];
                                <div @key="module.ModuleId" id="@TileElementId(module.ModuleId)"
                                     class="mws-module-tile @(module.ModuleId == _selectedId ? "selected" : "")" title="@module.Title" @onclick="() => SelectModule(module.ModuleId)">
                                    <div class="mws-module-tile-image">
                                        <div class="mws-module-tile-thumb" style="@(module.ThumbnailImageUrl is { } url ? $"background-image:url('{url}')" : null)"></div>
                                        <div class="mws-module-tile-border" aria-hidden="true"></div>
                                        <span class="mws-tile-version">v@(module.Version)</span>
                                    </div>
                                    <strong class="mws-module-tile-title">@module.Title</strong>
                                </div>
                            }
                        </div>
                        <button type="button" class="mws-carousel-nav-button mws-carousel-forward" disabled="@(!CanStepCarousel(1))"
                                @onclick="() => StepCarousel(1)" aria-label="@AppStrings.TimelineScrubber_Forward" title="@AppStrings.TimelineScrubber_Forward"></button>
                    </div>

                    @if (_selected is null)
                    {
                        <p class="mws-empty-state">@AppStrings.StartNewGame_SelectPrompt</p>
                    }
                    else
                    {
                        <div class="mws-module-detail">
                            <div class="mws-module-detail-header">
                                <strong class="mws-module-detail-title" title="@_selected.Title">@_selected.Title</strong>
                                <select class="mws-module-language" value="@_selectedLanguage" disabled="@(_selected.AvailableLanguages.Count <= 1)" @onchange="OnLanguageChanged">
                                    @foreach (var lang in _selected.AvailableLanguages)
                                    {
                                        <option value="@lang">@lang</option>
                                    }
                                </select>
                                <button type="button" class="mws-scenario-play-button" disabled="@_busy" @onclick="() => Play(_selected)">
                                    <span class="mws-visually-hidden">@AppStrings.StartNewGame_Play</span>
                                </button>
                            </div>
                            <div class="mws-module-detail-text">
                                <p>@_selected.Description</p>
                            </div>
                            <span class="mws-module-detail-version">v@(_selected.Version)</span>
                        </div>
                    }
                </div>

                @if (_conflictModule is not null)
                {
                    <div class="mws-dialog-overlay">
                        <div class="mws-dialog mws-dialog--sm">
                            <h3>@AppStrings.StartNewGame_ConflictTitle</h3>
                            <p>@string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_ConflictBody, _conflictModule.Title)</p>
                            @if (ConflictSaveSummary() is { } summary)
                            {
                                <p class="mws-save-timestamp">@summary</p>
                            }
                            <div class="mws-dialog-actions">
                                <button type="button" class="mws-btn-sm style-btn-green" disabled="@_busy" @onclick="ResumeConflicting">@AppStrings.Common_Resume</button>
                                <button type="button" class="mws-btn-sm style-btn-red" disabled="@_busy" @onclick="DiscardAndStartFresh">@AppStrings.StartNewGame_DiscardPrevious</button>
                                <button type="button" class="mws-btn-sm style-btn-brown" @onclick="() => { _conflictModule = null; _conflictSave = null; }">@AppStrings.Common_Cancel</button>
                            </div>
                        </div>
                    </div>
                }

                @if (_pendingUpload is not null)
                {
                    <div class="mws-dialog-overlay">
                        <div class="mws-dialog mws-dialog--sm">
                            <h3>@_pendingUpload.Title</h3>
                            <p>@_pendingUpload.Message</p>
                            <div class="mws-dialog-actions">
                                <button type="button" class="mws-btn-sm style-btn-green" disabled="@_busy" @onclick="ConfirmPendingUpload">@_pendingUpload.ConfirmLabel</button>
                                <button type="button" class="mws-btn-sm style-btn-brown" @onclick="() => _pendingUpload = null">@AppStrings.Common_Cancel</button>
                            </div>
                        </div>
                    </div>
                }

                <LoadingOverlay Show="@_loading" Message="@_loadingMessage" Done="@_loadingDone" Total="@_loadingTotal" />
            </div>
        </ChildContent>
        <ErrorContent>
            <div class="mws-start-new-game">
                <p class="mws-version-warning">@AppStrings.StartNewGame_ErrorFallback</p>
                <button type="button" class="style-btn-brown" @onclick="Recover">@AppStrings.Common_TryAgain</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</div>

@code {
    private sealed record PendingUpload(byte[] Bytes, string Sha256, string Title, string Message, string ConfirmLabel);

    private IReadOnlyList<InstalledModule> _modules = [];
    private string? _selectedId;
    private InstalledModule? _selected => _modules.FirstOrDefault(m => m.ModuleId == _selectedId);
    private string? _selectedLanguage;
    private InstalledModule? _conflictModule;
    private SaveEntry? _conflictSave;
    private string? _uploadError;
    private PendingUpload? _pendingUpload;
    private ErrorBoundary? _errorBoundary;
    private AppSettings _appSettings = AppSettings.Default;
    private bool _loading;
    private string _loadingMessage = "";
    private int? _loadingDone;
    private int? _loadingTotal;

    // Guards Play/ResumeConflicting/DiscardAndStartFresh/ConfirmPendingUpload/the upload handlers
    // against a double-click re-invoking one of them (or racing a different one) before the first
    // invocation's re-render disables the buttons -- see RenderedLinkView.HandleClick for why a
    // plain bool set before the first await is sufficient under Blazor's cooperative event dispatch.
    // Distinct from _loading (which only drives the LoadingOverlay's visibility/message and is
    // toggled on and off multiple times within a single one of these flows) -- _busy stays true for
    // an entry method's *entire* body, which is what double-clicking "Play" actually needs guarded:
    // without it, two clicks could both pass the pre-loading conflict check and each start their own
    // GameSession/State.Start, racing each other into /play.
    private bool _busy;

    // Carousel back/forward + click-to-select scrolling, same "hide the native scrollbar, scroll
    // the selected element into view via JS" technique PauseBar.razor's own timeline scrubber
    // already uses (see timelineScrubber.js's own remarks) -- kept the same, not reinvented.
    // Tiles are addressed by a DOM id built from ModuleId, not an @ref array -- see
    // PauseBar.razor's EntryElementId for why @ref was dropped from this pattern entirely.
    private string? _lastCenteredId;
    private IJSObjectReference? _jsModule;

    private static string TileElementId(string moduleId) => $"mws-module-tile-{moduleId}";

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _loading = true;
        _loadingMessage = AppStrings.Common_Loading;
        try
        {
            _modules = await ModuleStore.ListAsync();
            _appSettings = await SettingsStore.LoadAsync();
            // Deliberately starts with nothing selected — the carousel is meant to be browsed, not
            // auto-committed to whatever happened to load first.
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Masterwork.App.Shared/timelineScrubber.js");
        }

        // Only re-centers when the selection actually changes — every unrelated re-render
        // (e.g. an upload progress tick) would otherwise re-trigger the scroll animation. Same
        // guard PauseBar's own centering uses (_lastCenteredIndex there).
        if (_jsModule is null || _selectedId == _lastCenteredId)
        {
            return;
        }

        _lastCenteredId = _selectedId;
        if (_selectedId is null)
        {
            return;
        }

        try
        {
            await _jsModule.InvokeVoidAsync("centerElement", TileElementId(_selectedId));
        }
        catch (JSException)
        {
            // Best-effort UX polish only, same as PauseBar's own scrubber centering — rapid
            // clicking can race a re-render that swaps the referenced tile out from under this
            // call before it resolves. The correct tile is still selected either way.
        }
    }

    private int SelectedIndex()
    {
        for (var i = 0; i < _modules.Count; i++)
        {
            if (_modules[i].ModuleId == _selectedId)
            {
                return i;
            }
        }

        return -1;
    }

    private bool CanStepCarousel(int direction)
    {
        var next = SelectedIndex() + direction;
        return next >= 0 && next < _modules.Count;
    }

    private void StepCarousel(int direction)
    {
        var next = SelectedIndex() + direction;
        if (next < 0 || next >= _modules.Count)
        {
            return;
        }

        SelectModule(_modules[next].ModuleId);
    }

    private void Recover()
    {
        _errorBoundary?.Recover();
    }

    // Resets the language choice every time the selected module changes: the preferred module
    // language (Options) if that module actually has it, else the module's own default, else
    // whatever's there — never carries a previous module's language selection over by accident.
    private void SelectModule(string moduleId)
    {
        _selectedId = moduleId;
        _selectedLanguage = _selected is { } module ? DefaultLanguageFor(module, _appSettings.PreferredModuleLanguage) : null;
    }

    private static string DefaultLanguageFor(InstalledModule module, string? preferred)
    {
        if (preferred is not null && module.AvailableLanguages.Contains(preferred))
        {
            return preferred;
        }

        return module.AvailableLanguages.Contains(ModuleLocales.Default)
            ? ModuleLocales.Default
            : module.AvailableLanguages[0];
    }

    private void OnLanguageChanged(ChangeEventArgs e) => _selectedLanguage = e.Value?.ToString();

    // Shared by the verify/install/asset-preparation phases, all of which report a real (done,
    // total) rather than showing an indeterminate spinner — each just plugs in its own message
    // format. Fires from Progress<T>'s posted continuation, not the calling method's own await
    // chain, so it needs its own StateHasChanged rather than relying on the caller's next render.
    private void ReportProgress((int Done, int Total) p, string percentFormat)
    {
        _loadingDone = p.Done;
        _loadingTotal = p.Total;
        var percent = p.Total > 0 ? (int)(100.0 * p.Done / p.Total) : 0;
        _loadingMessage = string.Format(AppStrings.EffectiveCulture, percentFormat, percent);
        if (p.Total > 0 && p.Done == p.Total)
        {
            // Diagnostic: reported progress reaching 100% and the awaited call actually returning
            // (logged at each call site below) can be far apart in wall-clock time — e.g. a GC pause
            // reclaiming everything the phase just allocated. Comparing these two timestamps in the
            // browser console pins down whether a freeze is inside the library call's own tail or
            // something after it.
            Logger.LogInformation("Progress reached 100% at {Timestamp:O}", DateTime.UtcNow);
        }
        StateHasChanged();
    }

    private string? ConflictSaveSummary()
    {
        if (_conflictSave is null)
        {
            return null;
        }

        // DisplayName is null for the autosave, so this reads naturally either way: a named save's
        // own name leads, or (for the autosave) straight into where it left off.
        var parts = new[] { _conflictSave.DisplayName, _conflictSave.LastStateLabel, _conflictSave.LastPlayedUtc.ToLocalTime().ToString("g", AppStrings.EffectiveCulture), _conflictSave.Language }
            .Where(s => !string.IsNullOrEmpty(s));
        return string.Join(" · ", parts);
    }

    private async Task Play(InstalledModule? module)
    {
        if (_busy || module is null)
        {
            return;
        }

        _busy = true;
        try
        {
            // Whichever save (autosave or named) was actually played most recently wins — a manual
            // save taken after the autosave supersedes it here, same as it does everywhere else now
            // (see Play.razor's Save-and-Quit/Abandon, which both leave the autosave in place, and
            // ContinueList's own newer-autosave check).
            var saves = await SaveStore.ListAsync();
            var mostRecent = saves.Where(s => s.ModuleId == module.ModuleId).OrderByDescending(s => s.LastPlayedUtc).FirstOrDefault();
            if (mostRecent is not null)
            {
                _conflictModule = module;
                _conflictSave = mostRecent;
                return;
            }

            await StartFreshAsync(module, _selectedLanguage);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResumeConflicting()
    {
        if (_busy || _conflictModule is null || _conflictSave is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var module = _conflictModule;
            var saveEntry = _conflictSave;
            _conflictModule = null;
            _conflictSave = null;

            var json = await SaveStore.LoadAsync(saveEntry.Id);
            if (json is null)
            {
                await StartFreshAsync(module, _selectedLanguage);
                return;
            }

            SessionSave? save;
            try
            {
                save = JsonSerializer.Deserialize<SessionSave>(json);
            }
            catch (JsonException)
            {
                // A save from an incompatible/older save-format revision — treat exactly like no
                // save existing rather than crashing the app on a stale format the player can't do
                // anything about (see SnapshotKind's remarks for a concrete example of how this
                // happens).
                save = null;
            }

            if (save is null)
            {
                await StartFreshAsync(module, _selectedLanguage);
                return;
            }

            // Resuming always uses the save's own recorded language, not whatever's currently
            // picked in the dropdown — the save state is what decides, per the "preserved in the
            // save state" rule.
            _loading = true;
            _loadingMessage = AppStrings.Common_Loading;
            _loadingDone = null;
            _loadingTotal = null;
            try
            {
                var loaded = await ModuleStore.LoadAsync(module.ModuleId, saveEntry.Language);
                loaded = await PreloadAssetsAsync(loaded);
                var session = GameSession.Restore(loaded.Module, save, logger: GameSessionLogger);
                State.Start(module.ModuleId, module.Version, saveEntry.Language, loaded, session);
                await StyleInjector.ApplyAsync(loaded.StyleCss);
                Nav.NavigateTo("/play");
            }
            finally
            {
                _loading = false;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // Fetches every asset the module ships before Play/Resume navigates, with progress — a passage's
    // images/fonts are already resident by the time it first renders instead of popping in one at a
    // time as IAssetResolver's own lazy, per-reference fetches would otherwise complete.
    private async Task<LoadedModuleContent> PreloadAssetsAsync(LoadedModuleContent loaded)
    {
        // The previous session's preloaded object URLs (if any) are no longer reachable once this
        // new module's Assets replaces GameSessionState.Assets — revoke them now rather than leaking
        // their backing blobs for the rest of the tab's lifetime.
        if (State.Assets is PreloadedModuleAssetSource previous)
        {
            await previous.RevokeAllAsync(JS);
        }

        _loadingMessage = AppStrings.Common_PreparingAssets;
        _loadingDone = null;
        _loadingTotal = null;
        var progress = new Progress<(int Done, int Total)>(p => ReportProgress(p, AppStrings.Common_PreparingAssetsPercent));
        return await loaded.WithPreloadedAssetsAsync(progress);
    }

    private async Task DiscardAndStartFresh()
    {
        if (_busy || _conflictModule is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var module = _conflictModule;
            _conflictModule = null;
            _conflictSave = null;
            // No save is ever deleted here. Starting fresh implicitly overwrites the module's
            // autosave (Play.razor's first-render PersistAutosaveAsync upserts it via its
            // deterministic id), but a manual save is a distinct id entirely — it's left alone
            // regardless of whether it was the one just offered, still resumable later from Continue.
            await StartFreshAsync(module, _selectedLanguage);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartFreshAsync(InstalledModule module, string? language)
    {
        _loading = true;
        _loadingMessage = AppStrings.Common_Loading;
        _loadingDone = null;
        _loadingTotal = null;
        try
        {
            var loaded = await ModuleStore.LoadAsync(module.ModuleId, language);
            loaded = await PreloadAssetsAsync(loaded);
            var session = new GameSession(loaded.Module, masterSeed: Random.Shared.NextInt64(), logger: GameSessionLogger);
            State.Start(module.ModuleId, module.Version, language, loaded, session);
            await StyleInjector.ApplyAsync(loaded.StyleCss);
            Nav.NavigateTo("/play");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnUploadFileSelected(InputFileChangeEventArgs e)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            Logger.LogInformation("Module upload: InputFile selected {FileName} ({Size} bytes)", e.File.Name, e.File.Size);
            _uploadError = null;
            try
            {
                using var stream = e.File.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                var bytes = memory.ToArray();
                Logger.LogInformation("Module upload: read {Size} bytes from InputFile", bytes.Length);

                await ProcessUploadedBytesAsync(bytes);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Module upload: InputFile read/process failed");
                // ex.Message is an internal exception message (English, per the "behind the scenes
                // strings stay in code" rule) even though it surfaces in this user-facing dialog.
                _uploadError = string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_UploadError_Generic, ex.Message);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // MAUI-only path (FilePicker.IsAvailable) — see INativeFilePicker's own remarks for why this
    // bypasses the InputFile element entirely on that head instead of sharing OnUploadFileSelected.
    private async Task OnNativePickerClicked()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            Logger.LogInformation("Module upload: native picker opened");
            _uploadError = null;
            try
            {
                var bytes = await FilePicker.PickAsync(NativeFileKind.ModulePackage);
                if (bytes is null)
                {
                    Logger.LogInformation("Module upload: native picker cancelled");
                    return;
                }
                Logger.LogInformation("Module upload: read {Size} bytes from native picker", bytes.Length);

                await ProcessUploadedBytesAsync(bytes);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Module upload: native picker read/process failed");
                _uploadError = string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_UploadError_Generic, ex.Message);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // Shared by both upload paths above — everything from "bytes on disk" onward, regardless of how
    // they were picked. Reads only manifest.yaml (ReadManifestOnly), not the full package — the
    // conflict-check prompt only ever needs the manifest, and a full ModulePackage.ReadFromBytes
    // here would mean decompressing every asset in a 60+MB upload just to show a dialog.
    private async Task ProcessUploadedBytesAsync(byte[] bytes)
    {
        var manifestYaml = ModulePackage.ReadManifestOnly(bytes);
        if (manifestYaml is null)
        {
            Logger.LogWarning("Module upload: package has no manifest.yaml");
            _uploadError = AppStrings.StartNewGame_UploadError_NoManifest;
            return;
        }

        var manifest = new ManifestParser().Parse(manifestYaml);

        // The upload is hashed exactly once here, as part of "processing" the incoming file, with
        // its own progress feedback — not repeated later. Both the same-version conflict check below
        // and InstallAsync itself (which takes the hash as a parameter) reuse this one result rather
        // than re-hashing the same bytes a second and third time with no feedback.
        _loading = true;
        _loadingMessage = AppStrings.StartNewGame_Verifying;
        _loadingDone = null;
        _loadingTotal = null;
        string sha256;
        try
        {
            var progress = new Progress<(int Done, int Total)>(p => ReportProgress(p, AppStrings.StartNewGame_VerifyingPercent));
            sha256 = await ModuleHasher.ComputeHashAsync(bytes, progress, JS);
            Logger.LogInformation("Module upload: ComputeHashAsync returned at {Timestamp:O}", DateTime.UtcNow);
        }
        finally
        {
            _loading = false;
        }

        var existing = _modules.FirstOrDefault(m => m.ModuleId == manifest.Id);
        if (existing is null)
        {
            Logger.LogInformation("Module upload: installing new module {ModuleId} v{Version}", manifest.Id, manifest.Version);
            await InstallBytesAsync(bytes, sha256);
            return;
        }

        Logger.LogInformation("Module upload: {ModuleId} already installed (existing v{ExistingVersion}, uploaded v{UploadedVersion}) — prompting", manifest.Id, existing.Version, manifest.Version);
        await PrepareConflictPromptAsync(bytes, sha256, manifest, existing);
    }

    // Compares the uploaded manifest's version against what's already installed under the same id
    // and prepares an appropriately-worded confirm prompt — same content is a no-op-ish notice, an
    // upgrade/downgrade gets a warning scaled to the risk, mentioning existing saves if there are any
    // (masterwork-plan-rev14's upload-conflict design, added after manual testing surfaced the need).
    private async Task PrepareConflictPromptAsync(byte[] bytes, string sha256, ModuleManifest manifest, InstalledModule existing)
    {
        var saveCount = (await SaveStore.ListAsync()).Count(s => s.ModuleId == manifest.Id);
        var saveNote = saveCount switch
        {
            0 => "",
            1 => AppStrings.StartNewGame_SaveNote_One,
            _ => string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_SaveNote_Many, saveCount),
        };

        var comparison = SemVer.Compare(manifest.Version, existing.Version);

        if (comparison == 0)
        {
            // existing.Sha256 was already computed once, at that module's own install time (see
            // ModuleHasher) — comparing against the hash ProcessUploadedBytesAsync already computed
            // for the new upload needs no further hashing at all.
            var identical = string.Equals(sha256, existing.Sha256, StringComparison.OrdinalIgnoreCase);

            _pendingUpload = identical
                ? new PendingUpload(bytes, sha256, AppStrings.StartNewGame_AlreadyInstalledTitle,
                    string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_AlreadyInstalledBody, manifest.Title, manifest.Version),
                    AppStrings.StartNewGame_ReinstallAnyway)
                : new PendingUpload(bytes, sha256, AppStrings.StartNewGame_SameVersionDiffContentTitle,
                    string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_SameVersionDiffContentBody, manifest.Title, manifest.Version, saveNote),
                    AppStrings.StartNewGame_ReplaceAnyway);
            return;
        }

        if (comparison > 0)
        {
            _pendingUpload = new PendingUpload(bytes, sha256, AppStrings.StartNewGame_UpgradeTitle,
                string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_UpgradeBody, manifest.Title, existing.Version, manifest.Version, saveNote),
                AppStrings.StartNewGame_Upgrade);
            return;
        }

        _pendingUpload = new PendingUpload(bytes, sha256, AppStrings.StartNewGame_DowngradeTitle,
            string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_DowngradeBody, manifest.Title, existing.Version, manifest.Version, saveNote),
            AppStrings.StartNewGame_DowngradeAnyway);
    }

    private async Task ConfirmPendingUpload()
    {
        if (_busy || _pendingUpload is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var bytes = _pendingUpload.Bytes;
            var sha256 = _pendingUpload.Sha256;
            _pendingUpload = null;
            await InstallBytesAsync(bytes, sha256);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task InstallBytesAsync(byte[] bytes, string sha256)
    {
        _loading = true;
        _loadingMessage = AppStrings.StartNewGame_Installing;
        _loadingDone = null;
        _loadingTotal = null;

        var progress = new Progress<(int Done, int Total)>(p => ReportProgress(p, AppStrings.StartNewGame_InstallingPercent));

        try
        {
            var installed = await ModuleStore.InstallAsync(bytes, sha256, progress);
            _modules = await ModuleStore.ListAsync();
            SelectModule(installed.ModuleId);
            Logger.LogInformation("Module upload: installed {ModuleId} v{Version}", installed.ModuleId, installed.Version);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Module upload: install failed");
            // ex.Message is an internal exception message (English, per the "behind the scenes
            // strings stay in code" rule) even though it surfaces in this user-facing dialog.
            _uploadError = string.Format(AppStrings.EffectiveCulture, AppStrings.StartNewGame_UploadError_Generic, ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}

@page "/modules/browse"
@using Masterwork.App.Shared.Chrome
@using Masterwork.App.Shared.Resources
@using Masterwork.App.Shared.Services
@using Masterwork.ModuleFormat
@using Microsoft.Extensions.Logging
@inject CatalogService Catalog
@inject CatalogInstallService Installer
@inject ThumbnailCache Thumbnails
@inject ContentSource Source
@inject IModuleStore ModuleStore
@inject NavigationManager Nav
@inject ILogger<BrowseCatalog> Logger

@{ AppSettingsApplier.ReassertCulture(); }
<PageTitle>@AppStrings.BrowseCatalog_PageTitle</PageTitle>

@* Deliberately plain: 6.4 redesigns New Game and Manage Modules together, and this list is what
   makes catalog install reachable by hand before then. *@
<div class="mws-scenario-screen">
    <div class="mws-scenario-border" aria-hidden="true"></div>
    <ChromeButton class="mws-scenario-back-button" OnClick='() => Nav.NavigateTo("/modules/manage")'>
        <span class="mws-visually-hidden">@AppStrings.Common_Back</span>
    </ChromeButton>

    <h2 class="mws-screen-title">@AppStrings.BrowseCatalog_Heading</h2>

    @if (_loadFailed)
    {
        <p class="mws-version-warning">@AppStrings.BrowseCatalog_Unavailable</p>
    }
    else if (_snapshot is { } snapshot)
    {
        @* Only a trusted catalog can be installed from — an entry's hash is only as good as the
           signature over the catalog carrying it. Nothing here offers a way past that. *@
        @if (snapshot.Decision != PackageTrustDecision.Trusted)
        {
            <p class="mws-version-warning">@UntrustedMessage(snapshot)</p>
        }

        <div class="mws-manage-modules">
            @foreach (var entry in _entries)
            {
                <div class="mws-module-row" @key="entry.Id">
                    <div class="mws-catalog-thumb"
                         style="@(_thumbnails.GetValueOrDefault(entry.Id) is { } url ? $"background-image:url('{url}')" : null)"
                         aria-hidden="true"></div>
                    <div class="mws-module-row-info">
                        <strong>@entry.Title</strong>
                        <span class="mws-module-version">v@(entry.Version)</span>
                        <span class="mws-module-version">@FormatSize(entry.Size)</span>
                        @if (entry.Description is { Length: > 0 } description)
                        {
                            <p class="mws-catalog-description">@description</p>
                        }
                    </div>
                    @if (InstalledState(entry) is { } state && state == EntryState.UpToDate)
                    {
                        <span class="mws-module-version">@AppStrings.BrowseCatalog_Installed</span>
                    }
                    else
                    {
                        <ChromeButton class="mws-btn-sm style-btn-green"
                                      disabled="@(_busy || snapshot.Decision != PackageTrustDecision.Trusted)"
                                      OnClick="() => Install(entry)">
                            @(InstalledState(entry) == EntryState.UpdateAvailable
                                ? AppStrings.BrowseCatalog_Update
                                : AppStrings.BrowseCatalog_Install)
                        </ChromeButton>
                    }
                </div>
            }
        </div>

        @if (_entries.Count == 0)
        {
            <p>@AppStrings.BrowseCatalog_Empty</p>
        }
    }

    @if (_infoDialog is { } infoDialog)
    {
        <div class="mws-dialog-overlay">
            <div class="mws-dialog mws-dialog--sm">
                <h3>@infoDialog.Title</h3>
                <p>@infoDialog.Message</p>
                <div class="mws-dialog-actions">
                    <ChromeButton class="mws-btn-sm style-btn-brown" OnClick="() => _infoDialog = null">@AppStrings.Common_Ok</ChromeButton>
                </div>
            </div>
        </div>
    }

    <LoadingOverlay Show="@_loading" Message="@_loadingMessage" Done="@_loadingDone" Total="@_loadingTotal" />
</div>

@code {
    private enum EntryState
    {
        NotInstalled,
        UpToDate,
        UpdateAvailable,
    }

    private CatalogSnapshot? _snapshot;
    private IReadOnlyList<CatalogEntry> _entries = [];
    private IReadOnlyList<InstalledModule> _installed = [];
    private readonly Dictionary<string, string> _thumbnails = [];
    private (string Title, string Message)? _infoDialog;
    private bool _loadFailed;
    private bool _busy;
    private bool _loading;
    private string _loadingMessage = AppStrings.Common_Loading;
    private int? _loadingDone;
    private int? _loadingTotal;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _loadingMessage = AppStrings.Common_Loading;
        try
        {
            // ReturnToMenu, not ColdStart: arriving at this page mid-session shouldn't force a fetch
            // the refresh policy says isn't due yet.
            _snapshot = await Catalog.RefreshIfDueAsync(Source, CatalogRefreshTrigger.ReturnToMenu);
            _loadFailed = _snapshot is null;

            if (_snapshot is { } snapshot)
            {
                // Asset packs are listed in the catalog so a module's dependency can be resolved, but
                // they're never browsed or installed on their own — they arrive with whatever needs them.
                _entries = [.. snapshot.Catalog.Entries.Where(e => e.Type == "module")];
                _installed = await ModuleStore.ListAsync();
            }
        }
        finally
        {
            _loading = false;
        }

        // After the list paints, so a slow image fetch never holds up the page.
        await LoadThumbnailsAsync();
    }

    private async Task LoadThumbnailsAsync()
    {
        if (_snapshot is not { } snapshot)
        {
            return;
        }

        foreach (var entry in _entries)
        {
            if (await Thumbnails.GetAsync(snapshot.Source, entry) is { } url)
            {
                _thumbnails[entry.Id] = url;
                StateHasChanged();
            }
        }
    }

    private EntryState InstalledState(CatalogEntry entry)
    {
        var installed = _installed.FirstOrDefault(m => m.ModuleId == entry.Id);
        if (installed is null)
        {
            return EntryState.NotInstalled;
        }

        return SemVer.Compare(entry.Version, installed.Version) > 0
            ? EntryState.UpdateAvailable
            : EntryState.UpToDate;
    }

    private async Task Install(CatalogEntry entry)
    {
        if (_busy || _snapshot is not { } snapshot)
        {
            return;
        }

        _busy = true;
        _loading = true;
        _loadingDone = null;
        _loadingTotal = null;
        _loadingMessage = AppStrings.Common_Loading;

        var progress = new Progress<CatalogInstallProgress>(p =>
        {
            _loadingMessage = string.Format(AppStrings.EffectiveCulture, PhaseFormat(p.Phase), p.Title, p.Percent);
            StateHasChanged();
        });

        try
        {
            await Installer.InstallAsync(snapshot, entry, progress);
            _installed = await ModuleStore.ListAsync();
            Logger.LogInformation("Catalog: installed {Id} v{Version}", entry.Id, entry.Version);
        }
        catch (CatalogInstallException ex)
        {
            Logger.LogWarning(ex, "Catalog: install of {Id} failed", entry.Id);
            _infoDialog = (AppStrings.BrowseCatalog_InstallFailedTitle, ex.Message);
        }
        finally
        {
            _loading = false;
            _busy = false;
        }
    }

    private static string PhaseFormat(CatalogInstallPhase phase) => phase switch
    {
        CatalogInstallPhase.Downloading => AppStrings.BrowseCatalog_Downloading,
        CatalogInstallPhase.Verifying => AppStrings.BrowseCatalog_Verifying,
        _ => AppStrings.BrowseCatalog_Installing,
    };

    private static string UntrustedMessage(CatalogSnapshot snapshot) => snapshot.Decision switch
    {
        PackageTrustDecision.Blocked => AppStrings.BrowseCatalog_SignatureBlocked,
        PackageTrustDecision.Unsigned => AppStrings.BrowseCatalog_Unsigned,
        _ => string.Format(
            AppStrings.EffectiveCulture,
            AppStrings.BrowseCatalog_UnrecognizedSigner,
            snapshot.Signature.CertificateCommonName ?? ""),
    };

    private static string FormatSize(long bytes) =>
        string.Format(AppStrings.EffectiveCulture, AppStrings.BrowseCatalog_Megabytes, bytes / 1024d / 1024d);
}

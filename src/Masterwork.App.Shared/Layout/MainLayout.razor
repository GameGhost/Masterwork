@inherits LayoutComponentBase
@implements IDisposable
@using Masterwork.App.Shared.Services
@inject IAppSettingsStore SettingsStore
@inject IAudioPlayer AudioPlayer
@inject AudioSettingsState AudioState
@inject IMainMenuTheme Theme
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AppNavigationHistory NavHistory

@{ AppSettingsApplier.ReassertCulture(); }
@* This only fires on the very first paint and on page navigation (a layout doesn't re-render just
   because a page nested in @Body re-renders from its own internal state, like a dialog opening) —
   every page and every independently-re-rendering chrome component has this exact same line for
   that reason. See AppSettingsApplier.ReassertCulture's doc comment. *@
@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _splashHidden;

    // Feeds AppNavigationHistory — see its own remarks on why this lives here (MainLayout wraps
    // every page and is created exactly once per app session, so this is the one place a
    // LocationChanged subscription covers every navigation without needing to re-subscribe).
    protected override void OnInitialized()
    {
        var initialPath = Nav.ToBaseRelativePath(Nav.Uri);
        NavHistory.Track(initialPath);
        _previousPath = initialPath;
        Nav.LocationChanged += OnLocationChanged;
        HardwareBackButtonBridge.Register(Nav, NavHistory);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var newPath = Nav.ToBaseRelativePath(e.Location);
        NavHistory.Track(newPath);
        _ = SyncThemeMusicAsync(e.Location);
        _ = SyncThemeTransitionSfxAsync(newPath, cameFromPlay: IsPlayPath(_previousPath));
        _previousPath = newPath;
    }

    // Starts the theme's own background music whenever the app shell (anything other than /play) is
    // showing, but only actually triggers playback on a genuine shell<->play transition — not on
    // every intra-shell navigation (Main Menu -> Help -> Achievements shouldn't restart/crossfade
    // the theme track each time just because the route changed). /play itself never starts theme
    // music here — the flows that navigate into it (ContinueList/StartNewGame) already stop theme
    // music explicitly, immediately before navigating, rather than waiting for this handler to catch
    // up a tick later; returning from /play to the shell is what re-triggers this method into
    // actually starting it again.
    private bool _themeMusicActive;

    private async Task SyncThemeMusicAsync(string location)
    {
        var isPlayRoute = string.Equals(Nav.ToBaseRelativePath(location), "play", StringComparison.OrdinalIgnoreCase);
        if (isPlayRoute)
        {
            _themeMusicActive = false;
            return;
        }

        if (_themeMusicActive)
        {
            return;
        }

        _themeMusicActive = true;

        // PlayBgmAsync(null) is a no-op, not a stop (see IAudioPlayer's remarks) — a theme with no
        // music of its own must still explicitly silence whatever the module was playing a moment
        // ago on the way out of Play, or it would keep looping forever once back on the shell.
        if (Theme.MusicUrl is null)
        {
            await AudioPlayer.StopBgmAsync();
        }
        else
        {
            await AudioPlayer.PlayBgmAsync(Theme.MusicUrl);
        }
    }

    // The original app's own "welcome" window-transition clip only ever played on the main menu
    // itself — first launch, or landing back on it after a module ends/is quit — never on plain
    // in-shell navigation (Main Menu -> Help -> Achievements shouldn't replay it). So this fires
    // only when the *destination* is the main menu (root) and either this is app boot or the
    // player is arriving there straight from /play — tracked via _previousPath rather than
    // anything /play's own quit flows need to know about (they all just NavigateTo("/") like any
    // other navigation). Every other shell screen transition (Help, Achievements, New Game,
    // Continue, Manage Modules) plays no transition SFX at all now — those buttons get the
    // ordinary ChromeButton click sound instead, same as everywhere else in app chrome.
    private string? _previousPath;
    private bool _isBoot = true;

    private static bool IsPlayPath(string? path) => string.Equals(path, "play", StringComparison.OrdinalIgnoreCase);
    private static bool IsRootPath(string path) => string.IsNullOrEmpty(path);

    private async Task SyncThemeTransitionSfxAsync(string newPath, bool cameFromPlay)
    {
        var wasBoot = _isBoot;
        _isBoot = false;

        if (!IsRootPath(newPath) || Theme.TransitionSfxUrl is null)
        {
            return;
        }

        if (!cameFromPlay && !wasBoot)
        {
            return;
        }

        await AudioPlayer.PlaySfxAsync(Theme.TransitionSfxUrl);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    // Runs once per app session (MainLayout wraps every page and isn't recreated on navigation) —
    // this is what makes the saved Options actually take effect on a fresh launch/refresh instead
    // of only when the Options dialog itself is opened and Applied. OnAfterRenderAsync (rather than
    // OnInitializedAsync) is deliberate: it never runs during the server-side static prerender pass,
    // so no RendererInfo.IsInteractive guard is needed before these IJSRuntime-backed calls.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var settings = await SettingsStore.LoadAsync();
            await AppSettingsApplier.ApplyAsync(settings, AudioPlayer, AudioState, JS);
            await SyncThemeMusicAsync(Nav.Uri);
            await SyncThemeTransitionSfxAsync(Nav.ToBaseRelativePath(Nav.Uri), cameFromPlay: false);

            // The current page (@Body) already rendered once before this completed, using whatever
            // culture was in effect at that point — without this, the just-applied UI language
            // never becomes visible until something else happens to re-render the page.
            StateHasChanged();
        }
        else if (!_splashHidden && OperatingSystem.IsBrowser())
        {
            // Web only (mws-splash/window.mwsHideSplash only exist in Masterwork.App.Web's
            // App.razor) — this is the *second* time this method runs, i.e. the render right after
            // the StateHasChanged() above actually committed, so real (correctly-cultured) content
            // is genuinely on screen now. Tying splash removal to this instead of Blazor.start()'s
            // own promise is deliberate: that promise was found to resolve before the app's first
            // real render, leaving a blank-white gap between the splash disappearing and content
            // appearing (see masterwork-plan-rev18.md).
            _splashHidden = true;
            await JS.InvokeVoidAsync("mwsHideSplash");
        }
    }
}

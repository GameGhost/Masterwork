@namespace Masterwork.App.Shared.Rendering
@using Masterwork.Engine
@using Masterwork.Engine.Rendering

@if (!IsOpen)
{
    @if (!Node.AutoDisplay)
    {
        <button type="button" class="mws-popup-trigger style-@(Node.Style ?? "default")" disabled="@IsRewound" @onclick="Open">@Node.Label</button>
    }
}
else
{
    <div class="mws-popup-overlay layout-@(Node.Layout ?? "default") style-@(Node.Style ?? "default")">
        @* Purely structural — the app never inspects a node's style/layout to decide what goes
           where (no more "voting"/"bidding" special case; those retired in favor of a real
           declarative nested-popup pattern, see my-fathers-work-template's countdown_instructions/
           countdown_action). Header/Content/Footer are just three node-list regions the format
           already gives us (RenderedPopup.Header/Content, Okay/Cancel); module CSS is entirely
           responsible for what each one looks like. Node.Chrome is the same idea one level up —
           module-authored regions matched by Node.Layout's name, nesting outside this popup's own
           structural regions (see PassageView.razor for the same composition order applied to
           passages). *@
        @if (Node.Chrome.Header.Count > 0)
        {
            <div class="mws-layout-header">
                <NodeListView Nodes="Node.Chrome.Header" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" OnInputChanged="OnInputChanged" FirstFocusableInputId="@_firstFocusableInputId" />
            </div>
        }
        <div class="mws-popup-container">
            @if (Node.Header.Count > 0)
            {
                <div class="mws-popup-header">
                    <NodeListView Nodes="Node.Header" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" OnInputChanged="OnInputChanged" FirstFocusableInputId="@_firstFocusableInputId" />
                </div>
            }
            @if (Node.Chrome.BeforeContent.Count > 0)
            {
                <div class="mws-layout-before-content">
                    <NodeListView Nodes="Node.Chrome.BeforeContent" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" OnInputChanged="OnInputChanged" FirstFocusableInputId="@_firstFocusableInputId" />
                </div>
            }
            <div class="mws-popup-content">
                <NodeListView Nodes="Node.Content" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" OnInputChanged="OnInputChanged" FirstFocusableInputId="@_firstFocusableInputId" />
            </div>
            @if (Node.Chrome.AfterContent.Count > 0)
            {
                <div class="mws-layout-after-content">
                    <NodeListView Nodes="Node.Chrome.AfterContent" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" OnInputChanged="OnInputChanged" FirstFocusableInputId="@_firstFocusableInputId" />
                </div>
            }
            @if (Node.Okay is not null || Node.Cancel is not null)
            {
                @* Cancel before Okay in markup — Okay lands on the right in a left-to-right
                   flex row (web convention: primary action right, secondary left), and
                   keyboard tab order follows the same source order, so visual and tab order
                   agree instead of a CSS-only reorder desyncing them. *@
                <div class="mws-popup-footer">
                    @if (Node.Cancel is not null)
                    {
                        <button type="button" class="mws-popup-cancel" @onclick="Cancel">@Node.Cancel</button>
                    }
                    @if (Node.Okay is not null)
                    {
                        <button type="button" class="mws-popup-okay" disabled="@(_busy || !Session.AreInputsValid(Node.Actions))" @onclick="Accept">@Node.Okay</button>
                    }
                </div>
            }
        </div>
        @if (Node.Chrome.Footer.Count > 0)
        {
            <div class="mws-layout-footer">
                <NodeListView Nodes="Node.Chrome.Footer" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" OnInputChanged="OnInputChanged" FirstFocusableInputId="@_firstFocusableInputId" />
            </div>
        }
    </div>
}

@code {
    /// <summary>The popup node to render.</summary>
    [Parameter, EditorRequired]
    public RenderedPopup Node { get; set; } = null!;

    /// <summary>The active session — Accept calls <see cref="GameSession.ClosePopupAsync"/> directly; opening/cancelling never needs an engine call (see <see cref="RenderedPopup"/>'s remarks).</summary>
    [Parameter, EditorRequired]
    public GameSession Session { get; set; } = null!;

    /// <summary>Frozen (disabled trigger) while the timeline is rewound.</summary>
    [Parameter]
    public bool IsRewound { get; set; }

    /// <summary>Invoked after the popup closes.</summary>
    [Parameter]
    public EventCallback OnStateChanged { get; set; }

    /// <summary>Cheaper sibling of <see cref="OnStateChanged"/> for purely-local changes — see <see cref="PassageView.OnInputChanged"/>. Also used by <see cref="Cancel"/>, which only ever touches local view state, never <see cref="Session"/>.</summary>
    [Parameter]
    public EventCallback OnInputChanged { get; set; }

    private bool IsOpen => Session.ViewState.ExpandedPopups.Contains(Node.Id);
    private string? _firstFocusableInputId;

    protected override void OnInitialized()
    {
        if (Node.AutoDisplay && !IsRewound && !IsOpen)
        {
            Open();
        }
    }

    // Scoped to this popup's own regions only — never the enclosing passage's, and never a nested
    // popup's own content (see FocusHelper's remarks) — recomputed whenever Node itself changes (a
    // new passage render), same as PassageView's identical pattern. The open/closed toggle itself
    // doesn't need to recompute this: the @if/@else below tears down and recreates every input
    // inside when a popup opens, which is what actually triggers the one-time focus attempt (see
    // RenderedInputView's own remarks on why firstRender means exactly that here).
    protected override void OnParametersSet()
    {
        _firstFocusableInputId = FocusHelper.FindFirstFocusableInputId(
            Node.Chrome.Header, Node.Header, Node.Chrome.BeforeContent, Node.Content, Node.Chrome.AfterContent, Node.Chrome.Footer);
    }

    private void Open()
    {
        if (IsRewound)
        {
            return;
        }

        Session.ViewState.ExpandedPopups.Add(Node.Id);
    }

    // Guards against a double-click double-firing ClosePopupAsync — see RenderedLinkView's
    // HandleClick for why checking a plain bool set before the first await is sufficient under
    // Blazor's cooperative (one-synchronous-chunk-at-a-time) event dispatch. Not applied to Cancel,
    // which only ever touches local view state and is naturally idempotent either way.
    private bool _busy;

    private async Task Accept()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await Session.ClosePopupAsync(Node.Id, accept: true);
            await OnStateChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Cancel()
    {
        // Never touches Session — a plain dismiss with no navigation or committed state, so it's the
        // cheap path (no ambient-audio sync, no autosave), matching the reported "popups are slow to
        // dismiss even with no close/navigation action" symptom.
        Session.ViewState.ExpandedPopups.Remove(Node.Id);
        await OnInputChanged.InvokeAsync();
    }
}

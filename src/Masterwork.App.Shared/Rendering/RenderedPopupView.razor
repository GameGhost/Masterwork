@namespace Masterwork.App.Shared.Rendering
@using Masterwork.Engine
@using Masterwork.Engine.Rendering

@if (!IsOpen)
{
    @if (!Node.AutoDisplay)
    {
        <button type="button" class="mws-popup-trigger" disabled="@IsRewound" @onclick="Open">@Node.Label</button>
    }
}
else
{
    <div class="mws-popup-overlay layout-@(Node.Layout ?? "default")">
        @switch (Node.Layout)
        {
            case "voting":
                <VotingPopupContent Content="_content" Label="Cast your vote" Session="Session" OnClosed="Close" />
                break;
            case "bidding":
                <VotingPopupContent Content="_content" Label="Place your bid" Session="Session" OnClosed="Close" />
                break;
            default:
                @* end_of_generation / setup / no named layout: rendered as plain content for now —
                   named-layout-specific chrome (progress bar binding, ACCEPT button styling, etc.)
                   is a follow-up; see masterwork-plan Q11. *@
                <NodeListView Nodes="_content" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" />
                <button type="button" @onclick="Close">@(Node.Button ?? "Close")</button>
                break;
        }
    </div>
}

@code {
    /// <summary>The popup node to render.</summary>
    [Parameter, EditorRequired]
    public RenderedPopup Node { get; set; } = null!;

    /// <summary>The active session — opening/closing calls <see cref="GameSession.OpenPopupAsync"/>/<see cref="GameSession.ClosePopupAsync"/> directly.</summary>
    [Parameter, EditorRequired]
    public GameSession Session { get; set; } = null!;

    /// <summary>Frozen (disabled trigger) while the timeline is rewound.</summary>
    [Parameter]
    public bool IsRewound { get; set; }

    /// <summary>Invoked after the popup closes.</summary>
    [Parameter]
    public EventCallback OnStateChanged { get; set; }

    private IReadOnlyList<RenderedNode> _content = [];

    private bool IsOpen => Session.ViewState.ExpandedPopups.Contains(Node.Id);

    protected override async Task OnInitializedAsync()
    {
        if (Node.AutoDisplay && !IsRewound && !IsOpen)
        {
            await Open();
        }
    }

    private async Task Open()
    {
        if (IsRewound)
        {
            return;
        }

        var result = await Session.OpenPopupAsync(Node.Id);
        _content = result.Content;
        StateHasChanged();
    }

    private async Task Close()
    {
        await Session.ClosePopupAsync(Node.Id);
        _content = [];
        await OnStateChanged.InvokeAsync();
    }
}

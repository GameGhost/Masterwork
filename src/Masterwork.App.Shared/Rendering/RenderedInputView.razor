@namespace Masterwork.App.Shared.Rendering
@using Masterwork.Engine
@using Masterwork.Engine.Rendering
@using Masterwork.ModuleFormat
@inject IJSRuntime JS

<label class="mws-input style-@(Node.Style ?? "default")">
    @Node.Label
    @if (Node.InputType == InputValueType.Boolean)
    {
        <input type="checkbox"
               @key="Node.InputType"
               checked="@_checked"
               disabled="@IsRewound"
               @onchange="HandleCheckboxChange" />
    }
    else
    {
        <input type="@(Node.InputType == InputValueType.Number ? "number" : "text")"
               @key="Node.InputType"
               id="@InputElementId"
               min="@Node.Min" max="@Node.Max"
               value="@_value"
               disabled="@IsRewound"
               autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
               @oninput="HandleInput" />
    }
</label>

@code {
    /// <summary>The input node to render.</summary>
    [Parameter, EditorRequired]
    public RenderedInput Node { get; set; } = null!;

    /// <summary>The active session — the value is tracked as a draft via <see cref="GameSession.UpdateInputDraft"/> until a link/popup-Okay commits it.</summary>
    [Parameter, EditorRequired]
    public GameSession Session { get; set; } = null!;

    /// <summary>When rewound, shows the historical value from the snapshot instead of a live editable draft.</summary>
    [Parameter]
    public bool IsRewound { get; set; }

    /// <summary>
    /// The id of whichever input the enclosing passage/popup determined should receive automatic
    /// focus (see <see cref="FocusHelper"/>) — compared against <see cref="Node"/>'s own id, not
    /// passed down as a plain bool, so only one <c>RenderedInputView</c> instance out of however many
    /// render ever tries to focus itself.
    /// </summary>
    [Parameter]
    public string? FirstFocusableInputId { get; set; }

    /// <summary>
    /// Invoked after every keystroke so sibling components (e.g. a <c>link</c>'s disabled state,
    /// which depends on <see cref="GameSession.AreCurrentInputsValid"/>) re-render — Blazor only
    /// auto-re-renders the component whose own event handler fired, not siblings. A draft keystroke
    /// hasn't committed anything to <see cref="Session"/> (that only happens when a link is followed
    /// or a popup is accepted), so this is the cheap sibling of <c>OnStateChanged</c> — see
    /// <see cref="PassageView.OnInputChanged"/> — that skips ambient-audio sync and autosaving.
    /// </summary>
    [Parameter]
    public EventCallback OnInputChanged { get; set; }

    private string _value = "";
    private bool _checked;

    // A plain DOM id, not an ElementReference captured via @ref — see inputFocus.js's own comment
    // on OnAfterRenderAsync's call below for why. Prefixed against collision with anything else on
    // the page; Node.Id itself is just an author-chosen variable name, not guaranteed DOM-id-safe
    // or page-unique on its own.
    private string InputElementId => $"mws-input-{Node.Id}";

    protected override void OnParametersSet()
    {
        if (Node.InputType == InputValueType.Boolean)
        {
            _checked = IsRewound
                ? Session.Current.Variables.TryGetValue(Node.Var, out var historicalBool) && historicalBool.AsBool()
                : Session.ViewState.InputDrafts.TryGetValue(Node.Id, out var boolDraft) && boolDraft is true;
            return;
        }

        _value = IsRewound
            ? Session.Current.Variables.TryGetValue(Node.Var, out var historical) ? historical.AsString() : ""
            : Session.ViewState.InputDrafts.TryGetValue(Node.Id, out var draft) ? draft.ToString() ?? "" : "";
    }

    // Fires exactly once per genuine appearance of this specific input (a new passage render, or a
    // just-opened popup) — NodeListView keys each rendered node by its own object identity, and a new
    // passage/popup render always produces fresh RenderedInput instances, so this component (and thus
    // firstRender) is recreated then and only then; an unrelated re-render (e.g. a sibling input's own
    // keystroke) reuses this same instance and never sees firstRender again. Skipped for boolean
    // (checkbox) inputs and while rewound (disabled anyway, and nothing to type into mid-review).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !IsRewound && Node.InputType != InputValueType.Boolean && Node.Id == FirstFocusableInputId)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Masterwork.App.Shared/inputFocus.js");
            await module.InvokeVoidAsync("focusWithoutMobileKeyboard", InputElementId);
        }
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        _value = e.Value?.ToString() ?? "";
        Session.UpdateInputDraft(Node.Id, _value);
        await OnInputChanged.InvokeAsync();
    }

    private async Task HandleCheckboxChange(ChangeEventArgs e)
    {
        _checked = e.Value is bool b && b;
        Session.UpdateInputDraft(Node.Id, _checked);
        await OnInputChanged.InvokeAsync();
    }
}

@namespace Masterwork.App.Shared.Rendering
@using Masterwork.Engine
@using Masterwork.Engine.Rendering
@using Masterwork.App.Shared.Services
@inject IFormattedTextExpander FormattedTextExpander

<section class="mws-section style-@(Node.Style ?? "default")">
    @if (Node.Title is not null)
    {
        <h3>@_titleMarkup</h3>
    }
    <NodeListView Nodes="Node.Content" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" OnInputChanged="OnInputChanged" />
</section>

@code {
    /// <summary>The section node to render.</summary>
    [Parameter, EditorRequired]
    public RenderedSection Node { get; set; } = null!;

    /// <summary>The active session — interactive nodes call its methods directly.</summary>
    [Parameter, EditorRequired]
    public GameSession Session { get; set; } = null!;

    /// <summary>Whether the timeline is currently rewound — disables interactive controls.</summary>
    [Parameter]
    public bool IsRewound { get; set; }

    /// <summary>Invoked after an interactive node completes an action that may have changed <see cref="Session"/>'s current render.</summary>
    [Parameter]
    public EventCallback OnStateChanged { get; set; }

    /// <summary>Cheaper sibling of <see cref="OnStateChanged"/> for purely-local changes — see <see cref="PassageView.OnInputChanged"/>.</summary>
    [Parameter]
    public EventCallback OnInputChanged { get; set; }

    private MarkupString _titleMarkup;
    private string? _expandedFor;

    // See RenderedTextView's identical guard — skips re-running FormattedTextExpander's regex
    // passes on every cascaded re-render when Node.Title hasn't actually changed.
    protected override async Task OnParametersSetAsync()
    {
        if (Node.Title == _expandedFor)
        {
            return;
        }

        _titleMarkup = await FormattedTextExpander.ExpandAsync(Node.Title);
        _expandedFor = Node.Title;
    }
}

@namespace Masterwork.App.Shared.Rendering
@using Masterwork.Engine
@using Masterwork.Engine.Rendering

@if (Result.LocationName is not null)
{
    <header class="mws-location-header">
        @if (Result.LocationIcon is not null)
        {
            <span class="mws-location-icon">@Result.LocationIcon</span>
        }
        <span class="mws-location-name">@Result.LocationName</span>
    </header>
}

<div class="mws-passage layout-@Result.Layout">
    @* Layout chrome (Result.Chrome) is purely structural — module-authored regions matched by
       Result.Layout's name, rendered wherever their list is non-empty. The app never inspects what
       a chrome region contains or what the layout name means (see docs/mws-format-latest.md). *@
    @if (Result.Chrome.Header.Count > 0)
    {
        <div class="mws-layout-header">
            <NodeListView Nodes="Result.Chrome.Header" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" />
        </div>
    }
    @if (Result.Title is not null)
    {
        <header class="mws-passage-header">
            <h1 class="mws-passage-title">@Result.Title</h1>
            @if (Result.Subtitle is not null)
            {
                <p class="mws-passage-subtitle">@Result.Subtitle</p>
            }
        </header>
    }
    @if (Result.Chrome.BeforeContent.Count > 0)
    {
        <div class="mws-layout-before-content">
            <NodeListView Nodes="Result.Chrome.BeforeContent" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" />
        </div>
    }
    <div class="mws-passage-body">
        <NodeListView Nodes="Result.Nodes" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" />
    </div>
    @if (Result.Chrome.AfterContent.Count > 0)
    {
        <div class="mws-layout-after-content">
            <NodeListView Nodes="Result.Chrome.AfterContent" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" />
        </div>
    }
    @if (Result.Chrome.Footer.Count > 0)
    {
        <div class="mws-layout-footer">
            <NodeListView Nodes="Result.Chrome.Footer" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" />
        </div>
    }
</div>

@code {
    /// <summary>The passage render to display.</summary>
    [Parameter, EditorRequired]
    public PassageRenderResult Result { get; set; } = null!;

    /// <summary>The active session — interactive nodes call its methods directly.</summary>
    [Parameter, EditorRequired]
    public GameSession Session { get; set; } = null!;

    /// <summary>Whether the timeline is currently rewound — disables interactive controls.</summary>
    [Parameter]
    public bool IsRewound { get; set; }

    /// <summary>Invoked after an interactive node completes an action that may have changed <see cref="Session"/>'s current render.</summary>
    [Parameter]
    public EventCallback OnStateChanged { get; set; }
}

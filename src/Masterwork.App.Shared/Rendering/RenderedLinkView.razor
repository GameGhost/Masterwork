@namespace Masterwork.App.Shared.Rendering
@using Masterwork.Engine
@using Masterwork.Engine.Rendering

<button type="button" class="mws-link style-@(Node.Style ?? "link") @(Node.StateAffecting ? "state-affecting" : "in-place")" disabled="@(_busy || IsRewound || !Session.AreCurrentInputsValid())" @onclick="HandleClick">
    @Node.Label
</button>

@code {
    /// <summary>The link node to render.</summary>
    [Parameter, EditorRequired]
    public RenderedLink Node { get; set; } = null!;

    /// <summary>The active session — following the link calls <see cref="GameSession.FollowLinkAsync"/> directly.</summary>
    [Parameter, EditorRequired]
    public GameSession Session { get; set; } = null!;

    /// <summary>Frozen (disabled) while the timeline is rewound.</summary>
    [Parameter]
    public bool IsRewound { get; set; }

    /// <summary>Invoked after the link is followed.</summary>
    [Parameter]
    public EventCallback OnStateChanged { get; set; }

    // Blazor dispatches UI events one synchronous chunk at a time (cooperative, not truly
    // concurrent) -- a rapid double-click can still invoke this handler twice before the first
    // click's re-render disables the button, but the second invocation's synchronous prefix always
    // runs after the first's, so checking _busy here (set before the first await) reliably blocks
    // it. Without this, two clicks on a state-affecting link raced FollowLinkAsync against itself,
    // which could try to start a second passage transition mid-navigation.
    private bool _busy;

    private async Task HandleClick()
    {
        if (_busy || IsRewound || !Session.AreCurrentInputsValid())
        {
            return;
        }

        _busy = true;
        try
        {
            await Session.FollowLinkAsync(Node.Id);
            await OnStateChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}

@namespace Masterwork.App.Shared.Rendering
@using System.Runtime.CompilerServices
@using Masterwork.Engine
@using Masterwork.Engine.Rendering

@* @key must identify each node instance uniquely within this render (so Blazor doesn't reuse a
   component instance — and skip its OnInitialized[Async] — across genuinely different content; see
   the RenderedPopupView auto-display bug this fixed). RenderedNode subtypes are records, so using a
   node directly as the key would use *value* equality: two structurally-identical-but-distinct
   nodes (e.g. two sibling {type: 'break', style: 'paragraph'} nodes, which carry no other data)
   would collide as "the same key" and Blazor throws. RuntimeHelpers.GetHashCode gives a
   per-object-instance identity hash instead, sidestepping the record's overridden equality. *@
@foreach (var node in Nodes)
{
    var key = RuntimeHelpers.GetHashCode(node);
    @switch (node)
    {
        case RenderedText text:
            <RenderedTextView @key="key" Node="text" />
            break;
        case RenderedBreak brk:
            <RenderedBreakView @key="key" Node="brk" />
            break;
        case RenderedImage image:
            <RenderedImageView @key="key" Node="image" />
            break;
        case RenderedSection section:
            <RenderedSectionView @key="key" Node="section" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" OnInputChanged="OnInputChanged" FirstFocusableInputId="@FirstFocusableInputId" />
            break;
        case RenderedLink link:
            <RenderedLinkView @key="key" Node="link" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" />
            break;
        case RenderedInput input:
            <RenderedInputView @key="key" Node="input" Session="Session" IsRewound="IsRewound" OnInputChanged="OnInputChanged" FirstFocusableInputId="@FirstFocusableInputId" />
            break;
        case RenderedPopup popup:
            <RenderedPopupView @key="key" Node="popup" Session="Session" IsRewound="IsRewound" OnStateChanged="OnStateChanged" OnInputChanged="OnInputChanged" />
            break;
    }
}

@code {
    /// <summary>The node list to render, in document order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<RenderedNode> Nodes { get; set; } = [];

    /// <summary>The active session — interactive nodes call its methods directly.</summary>
    [Parameter, EditorRequired]
    public GameSession Session { get; set; } = null!;

    /// <summary>Whether the timeline is currently rewound — disables interactive controls.</summary>
    [Parameter]
    public bool IsRewound { get; set; }

    /// <summary>Invoked after an interactive node completes an action that may have changed <see cref="Session"/>'s current render.</summary>
    [Parameter]
    public EventCallback OnStateChanged { get; set; }

    /// <summary>Cheaper sibling of <see cref="OnStateChanged"/> for purely-local changes — see <see cref="PassageView.OnInputChanged"/>.</summary>
    [Parameter]
    public EventCallback OnInputChanged { get; set; }

    /// <summary>
    /// The id of whichever input should receive automatic focus, if any — see <see cref="FocusHelper"/>.
    /// Forwarded into a nested <see cref="RenderedSectionView"/> (part of the same scope) but not
    /// into a <see cref="RenderedPopupView"/>'s own content — a popup computes its own independently.
    /// </summary>
    [Parameter]
    public string? FirstFocusableInputId { get; set; }
}

@namespace Masterwork.App.Shared.Rendering
@using Masterwork.Engine.Rendering
@using Masterwork.App.Shared.Services
@using Masterwork.ModuleFormat
@inject IFormattedTextExpander FormattedTextExpander

<div class="mws-text@(AlignClass) style-@(Node.Style ?? "default")">@_rendered</div>

@code {
    /// <summary>The text node to render.</summary>
    [Parameter, EditorRequired]
    public RenderedText Node { get; set; } = null!;

    private MarkupString _rendered;
    private string? _expandedFor;

    private string AlignClass => Node.Align switch
    {
        Alignment.Left => " align-left",
        Alignment.Center => " align-center",
        Alignment.Right => " align-right",
        Alignment.Justified => " align-justified",
        _ => "",
    };

    // Result records are immutable and re-rendered fresh on every StateHasChanged() cascade even
    // when nothing about this node actually changed (e.g. a sibling input's keystroke) — re-running
    // FormattedTextExpander's regex passes every time is pure waste when Node.Value is the same
    // string as last render.
    protected override async Task OnParametersSetAsync()
    {
        if (Node.Value == _expandedFor)
        {
            return;
        }

        _rendered = await FormattedTextExpander.ExpandAsync(Node.Value);
        _expandedFor = Node.Value;
    }
}

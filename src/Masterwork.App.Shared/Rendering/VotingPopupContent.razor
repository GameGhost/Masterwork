@namespace Masterwork.App.Shared.Rendering
@using Masterwork.Engine
@using Masterwork.Engine.Rendering

@* Shared mechanics for the 'voting' and 'bidding' popup layouts (docs/mws-format-latest.md §4.2):
   a countdown, then a Reveal action, then the content. Manual step-advance for now rather than a
   real timed countdown/animation — see masterwork-plan Q11 follow-up. *@
<div class="mws-voting-popup">
    <h4>@Label</h4>
    @if (_stage < 3)
    {
        <p class="mws-countdown">@(_stage + 1)</p>
        <button type="button" @onclick="() => _stage++">Next</button>
    }
    else if (!_revealed)
    {
        <button type="button" @onclick="() => _revealed = true">Reveal</button>
    }
    else
    {
        <NodeListView Nodes="Content" Session="Session" IsRewound="false" OnStateChanged="OnClosed" />
        <button type="button" @onclick="() => OnClosed.InvokeAsync()">Continue</button>
    }
</div>

@code {
    /// <summary>The popup's (already-evaluated) content nodes.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<RenderedNode> Content { get; set; } = [];

    /// <summary>Display label — "Cast your vote" for <c>voting</c>, "Place your bid" for <c>bidding</c>.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>The active session, passed through in case content nodes contain further links.</summary>
    [Parameter, EditorRequired]
    public GameSession Session { get; set; } = null!;

    /// <summary>Invoked once the player confirms/continues past the reveal — closes the popup.</summary>
    [Parameter]
    public EventCallback OnClosed { get; set; }

    private int _stage;
    private bool _revealed;
}

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time tool for Masterwork.App.Web.Static: writes that head's flavor-specific index.html and
       manifest.json. It imports the flavor like a head does, so it carries the same theme the static
       head is built as. Never shipped. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterwork.App.Shared\Masterwork.App.Shared.csproj" />
  </ItemGroup>

  <Import Project="..\WhiteLabel\WhiteLabel.props" />

</Project>

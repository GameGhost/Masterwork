<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Required for `dotnet publish -p:RuntimeIdentifierOverride=win-x64` (unpackaged Windows
       publish) to work at all — works around a Windows App SDK bug where the implicit RID picked
       for an unpackaged Release build doesn't match what publish actually needs. Only takes effect
       when RuntimeIdentifierOverride is explicitly passed; a plain build/publish is unaffected.
       See https://github.com/microsoft/WindowsAppSDK/issues/3337 and
       https://learn.microsoft.com/dotnet/maui/windows/deployment/publish-unpackaged-cli. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup>
    <!-- iOS/MacCatalyst deferred for now (no Mac build host available). Re-add
         "net10.0-ios;net10.0-maccatalyst" to TargetFrameworks below when ready. -->
    <!-- Android build requires JavaSdkDirectory/AndroidSdkDirectory (see Directory.Build.local.props.example)
         and adds noticeable build time. Pass -p:BuildAndroid=false to skip it for fast iteration
         (e.g. while only running unit tests or working on the web client). -->
    <BuildAndroid Condition="'$(BuildAndroid)' == ''">true</BuildAndroid>
    <TargetFrameworks Condition="'$(BuildAndroid)' == 'true'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <!-- Note for MacCatalyst:
      The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
      When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
      The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
      either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
    <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

    <OutputType>Exe</OutputType>
    <RootNamespace>Masterwork.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <!-- Enable XAML source generation for faster build times and improved performance.
         This generates C# code from XAML at compile time instead of runtime inflation.
         To disable, remove this line.
         For individual files, you can override by setting Inflator metadata:
           <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
           <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- ApplicationTitle, ApplicationId, MauiIcon and MauiSplashScreen come from the white-label
         flavor — see the WhiteLabel.props import at the end of this file. -->

    <!-- Versions — the display version is VersionPrefix in the root Directory.Build.props.
         ApplicationVersion (Android versionCode / build number) stays a positive integer regardless of
         the 0.x display version, per platform requirements. Bump it on every release that changes the
         Android build, even between the same display version — Android treats versionCode as the sole
         update/downgrade signal. -->
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <ApplicationVersion>8</ApplicationVersion>

    <!-- Unpackaged (the portable zip) unless this is a Microsoft Store build; see below. -->
    <WindowsPackageType Condition="'$(StorePackage)' != 'true'">None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- R8 optimization, shrinking and private-member obfuscation of the Java bytecode. Google Play
       expects at least 25% of each from apps with more than 10 MB of DEX (this app has about 15 MB).
       Needs .NET for Android 36.1.118 or later; .NET 10 leaves obfuscation off unless set. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidR8ObfuscationMode>private-members</AndroidR8ObfuscationMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.80" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterwork.App.Shared\Masterwork.App.Shared.csproj" />
  </ItemGroup>

  <Import Project="..\WhiteLabel\WhiteLabel.props" />

  <!-- Microsoft Store build: -p:StorePackage=true, one publish per Windows architecture, bundled by
       scripts/release.ps1. Produces an unsigned MSIX under bin\Store\AppPackages\; Partner Center
       signs what it distributes. Builds into bin\Store\ and obj\Store\ (Directory.Build.props). -->
  <PropertyGroup Condition="'$(StorePackage)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageDir>$(MSBuildProjectDirectory)\$(BaseOutputPath)AppPackages\</AppxPackageDir>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- Stamps the flavor's Partner Center identity and reserved store name onto the manifest MAUI
       generates, after it fills its placeholders and before anything reads the result. The version's
       fourth part must be 0: the Store reserves it. -->
  <Target Name="ApplyStorePackageIdentity"
          AfterTargets="MauiGeneratePackageAppxManifest"
          BeforeTargets="_MauiGetAssemblyAttributesFromAppxManifest"
          Condition="'$(StorePackage)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Error Condition="'$(StoreIdentityName)' == '' or '$(StorePublisher)' == '' or '$(StorePublisherDisplayName)' == '' or '$(StoreDisplayName)' == ''"
           Text="The $(WhiteLabelFlavor) flavor has no Microsoft Store identity. Set StoreIdentityName, StorePublisher, StorePublisherDisplayName and StoreDisplayName in src/WhiteLabel/$(WhiteLabelFlavor).props from Partner Center's Product identity page." />

    <PropertyGroup>
      <_StoreManifest>$(_MauiIntermediateManifest)Package.appxmanifest</_StoreManifest>
      <_StoreManifestNamespaces>&lt;Namespace Prefix='ns' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;</_StoreManifestNamespaces>
    </PropertyGroup>

    <XmlPoke XmlInputPath="$(_StoreManifest)" Namespaces="$(_StoreManifestNamespaces)" Query="/ns:Package/ns:Identity/@Name" Value="$(StoreIdentityName)" />
    <XmlPoke XmlInputPath="$(_StoreManifest)" Namespaces="$(_StoreManifestNamespaces)" Query="/ns:Package/ns:Identity/@Publisher" Value="$(StorePublisher)" />
    <XmlPoke XmlInputPath="$(_StoreManifest)" Namespaces="$(_StoreManifestNamespaces)" Query="/ns:Package/ns:Identity/@Version" Value="$(VersionPrefix).0" />
    <XmlPoke XmlInputPath="$(_StoreManifest)" Namespaces="$(_StoreManifestNamespaces)" Query="/ns:Package/ns:Properties/ns:DisplayName" Value="$(StoreDisplayName)" />
    <XmlPoke XmlInputPath="$(_StoreManifest)" Namespaces="$(_StoreManifestNamespaces)" Query="/ns:Package/ns:Properties/ns:PublisherDisplayName" Value="$(StorePublisherDisplayName)" />
  </Target>

</Project>

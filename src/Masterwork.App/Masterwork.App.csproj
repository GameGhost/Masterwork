<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Required for `dotnet publish -p:RuntimeIdentifierOverride=win-x64` (unpackaged Windows
       publish) to work at all — works around a Windows App SDK bug where the implicit RID picked
       for an unpackaged Release build doesn't match what publish actually needs. Only takes effect
       when RuntimeIdentifierOverride is explicitly passed; a plain build/publish is unaffected.
       See https://github.com/microsoft/WindowsAppSDK/issues/3337 and
       https://learn.microsoft.com/dotnet/maui/windows/deployment/publish-unpackaged-cli. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup>
    <!-- iOS/MacCatalyst deferred for now (no Mac build host available). Re-add
         "net10.0-ios;net10.0-maccatalyst" to TargetFrameworks below when ready. -->
    <!-- Android build requires JavaSdkDirectory/AndroidSdkDirectory (see Directory.Build.local.props.example)
         and adds noticeable build time. Pass -p:BuildAndroid=false to skip it for fast iteration
         (e.g. while only running unit tests or working on the web client). -->
    <BuildAndroid Condition="'$(BuildAndroid)' == ''">true</BuildAndroid>
    <TargetFrameworks Condition="'$(BuildAndroid)' == 'true'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <!-- Note for MacCatalyst:
      The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
      When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
      The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
      either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
    <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

    <OutputType>Exe</OutputType>
    <RootNamespace>Masterwork.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <!-- Enable XAML source generation for faster build times and improved performance.
         This generates C# code from XAML at compile time instead of runtime inflation.
         To disable, remove this line.
         For individual files, you can override by setting Inflator metadata:
           <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
           <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Display name -->
    <ApplicationTitle>Masterwork: My Father's Work</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>ca.digitalghost.masterwork.app</ApplicationId>

    <!-- Versions — pre-release; ApplicationVersion (Android versionCode / build number) stays a
         positive integer regardless of the 0.x display version, per platform requirements. Bump
         ApplicationVersion on every release that changes the Android build, even between the same
         ApplicationDisplayVersion — Android treats versionCode as the sole update/downgrade signal. -->
    <ApplicationDisplayVersion>0.1.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>

    <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon — standard MauiIcon shape: `Include`/`BackgroundFile` is background only (a flat
         #1B1D21 fill, generated, not hand-authored). `ForegroundFile` is the logo alone, generated
         from Masterwork.App.Theme.MyFathersWork/wwwroot/images/myfatherswork-logo-1024x1024.png (the
         official wordmark, transparent background; see that project's own NOTICE.md for provenance),
         scaled to ~68% of its own canvas with transparent padding — confirmed empirically that
         Resizetizer does *not* apply its own extra inset for Android's adaptive icon, so the raw
         logo's own built-in gutter (~95% width / ~77% height of its canvas) isn't enough margin on
         its own; without this, Android's circular/squircle/rounded-square launcher mask crops the
         logo's own edges. This same file is used for every platform (Windows/iOS/legacy-Android/
         round icon all get it full-size, just with a bit more background margin than a full-bleed
         mark would have — a deliberate simplification over maintaining a separate per-platform
         source). Resizetizer composites foreground over background itself — earlier attempts
         pre-baked the logo into `Include` *and* separately passed a full `ForegroundFile`, which
         Resizetizer composited a second time on top, producing a visible double-exposed logo. -->
    <MauiIcon Include="..\Masterwork.App.Theme.MyFathersWork\AppIcon\appicon-background.png"
              ForegroundFile="..\Masterwork.App.Theme.MyFathersWork\AppIcon\appicon-foreground.png"
              Link="Resources\AppIcon\appicon.png" />

    <!-- Splash Screen — the same properly-centered square logo the app icon derives from (not the
         wide 1024x512 lockup, whose large dead space on one side was scaling/centering oddly here),
         on the same #1B1D21 background as the icon for a consistent brand mark. BaseSize bumped up
         (was 400,200 against the old wide image) so the logo actually reads as prominent on launch. -->
    <MauiSplashScreen Include="..\Masterwork.App.Theme.MyFathersWork\wwwroot\images\myfatherswork-logo-1024x1024.png" Link="Resources\Splash\splash.png" Color="#1B1D21" BaseSize="512,512" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.80" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterwork.App.Shared\Masterwork.App.Shared.csproj" />
    <!-- Direct reference (not just transitive via App.Shared) needed for compile-time visibility of
         MainMenuScene and any other theme component types this host wires into Shared's
         IMainMenuTheme/etc. at startup — App.Shared's own reference to this project only carries its
         static web assets through, not C# type visibility. -->
    <ProjectReference Include="..\Masterwork.App.Theme.MyFathersWork\Masterwork.App.Theme.MyFathersWork.csproj" />
  </ItemGroup>

</Project>
